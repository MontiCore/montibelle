definition f2s::"(nat \<Rightarrow> 'a) \<Rightarrow> 'a stream" where
"f2s f = smap f\<cdot>natstream"

lemma f2slen[simp]:"# (f2s f) = \<infinity>"
  by(simp add: f2s_def)

lemma f2s_snth[simp]:"snth n (f2s f) = f n"
  apply(simp add: f2s_def)
  apply(subst smap_snth_lemma)
  using natstreamlen natstream_def by auto

lemma smap_obtainin:assumes"sValues\<cdot>s \<subseteq> f` S"
  shows "\<exists>s2. smap f\<cdot>s2 = s"
  using assms proof(auto simp add: sValues_def2)
  assume a1:"{snth n s |n::nat. Fin n < #s} \<subseteq> f ` S"
  then have a2:"\<And>n. Fin n < #s \<Longrightarrow> \<exists>x\<in>S. f x = snth n s"
    by fastforce
  let ?testf="\<lambda>n. if Fin n < #s then SOME x. f x= snth n s else undefined"
  have h2:"\<And>n. Fin n < #s \<Longrightarrow> f(?testf n) = snth n s"
    using a2 tfl_some by force
  then show "\<exists>s2::'b stream. smap f\<cdot>s2 = s"
    apply(cases "#s=\<infinity>")
    apply(rule_tac x="f2s ?testf" in exI)
    apply(rule snths_eq,auto)
    apply(subst smap_snth_lemma,simp_all)
    apply(rule_tac x="stake (THE n. Fin n = #s)\<cdot>(f2s ?testf)" in exI)
    apply(rule snths_eq,auto)
    apply (subst f2slen slen_stake_fst_inf)
    using f2slen apply blast
    using ninf2Fin apply fastforce
    apply(subst smap_snth_lemma,simp_all)
    apply(subst stake_snths)
    apply (simp add: slen_stake_fst_inf; fail)
    apply simp
    apply (case_tac "#s")
    apply (simp add: slen_stake_fst_inf)
    by blast
qed

