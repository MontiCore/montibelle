lemma weak_len_mono2cont:
  fixes spf::"'in stream \<Rightarrow> 'out stream"
  assumes weak: "\<And>i. #i \<le> #(spf i)"
  and mono: "monofun spf"
shows "cont spf"
proof (rule contI2)
  show "monofun spf" using assms(2) .
next
  fix Y
  assume "chain Y" and "chain (\<lambda>i. spf (Y i))"
        and  "\<not>finite_chain Y"

  have h1: "# (\<Squnion>i. spf (Y i)) = \<infinity>"
  proof(rule ccontr)
    assume "# (\<Squnion>i. spf (Y i)) \<noteq> \<infinity>"
    obtain n where "# (\<Squnion>i. spf (Y i)) = Fin n"
      using \<open># (\<Squnion>i. spf (Y i)) \<noteq> \<infinity>\<close> infI by blast
    have "chain (\<lambda>i. #(Y i))"
      by (simp add: \<open>chain Y\<close> ch2ch_monofun len_class.len_mono)
    moreover have "\<not>finite_chain (\<lambda>i. #(Y i))"
      by (metis LNat.lnat.distinct(1) Stream.inf_chainl3 \<open>\<not> finite_chain Y\<close> \<open>chain Y\<close> below_lub calculation inf_belowI inf_chainl1 l42 lnle_def)
    ultimately obtain i where "Fin n < #(Y i)"
      by (metis below_fin_imp_ninf leI lnle_conv lub_below unique_inf_lub)
    thus False
      by (metis \<open>#(\<Squnion>i. spf (Y i)) = Fin n\<close> \<open>chain (\<lambda>i. spf (Y i))\<close> assms(1) is_ub_thelub less_le_trans mono_len not_less)
  qed

  have "(\<Squnion>i. spf (Y i)) = spf (\<Squnion>i. Y i)"
    apply(rule len_max)
    using h1 apply (simp; fail)
    by (simp add: \<open>chain (\<lambda>i. spf (Y i))\<close> \<open>chain Y\<close> is_ub_thelub lub_below mono monofunE)
  thus "spf (\<Squnion>i. Y i) \<sqsubseteq> (\<Squnion>i. spf (Y i))" by auto
qed

