  by (simp add: tlen_stream_def)

lemma stream_tlen_eps[simp]: "#\<^sub>\<surd>\<epsilon> = 0"
  apply(subst tlen_stream_def)
  by (simp add: lnzero_def)

lemma stream_tlen_step[simp]: "#\<^sub>\<surd> (\<up>xs \<Zcat> x) = #\<^sub>\<surd>xs + #\<^sub>\<surd>x"
  apply(subst tlen_stream_def, subst lscons_conv[symmetric])
  by (simp add: ladd_insert lnat_plus_commu tlen_stream_def lnzero_def)

lemma stream_tlen_step2: "#\<^sub>\<surd> (\<up>xs \<Zcat> x) = #\<^sub>\<surd>x + #\<^sub>\<surd>xs"
  apply(subst tlen_stream_def, subst lscons_conv[symmetric])
  by (simp add: ladd_insert lnat_plus_commu tlen_stream_def lnzero_def)

lemma stream_tlen_up[simp]: "#\<^sub>\<surd> (\<up>a) = #\<^sub>\<surd> a"
  by(insert stream_tlen_step[of a \<epsilon>],simp)

lemma steam_tlen_inf: "#\<^sub>\<surd>a \<noteq> 0 \<Longrightarrow> #\<^sub>\<surd>(sinftimes (\<up>a)) = \<infinity>"
  using inf_ub le2lnle lnat_plus_suc lnle_def lnless_def sinftimes_unfold stream_tlen_step2
  by (metis plus_lnat0_l plus_unique_r)

lemma smap_tlen:
  fixes f :: "('a::{countable, tlen}) \<Rightarrow> ('b::{countable, tlen})"
  assumes "\<And>x. x \<in> sValues\<cdot>s \<Longrightarrow> #\<^sub>\<surd>(f x) = #\<^sub>\<surd>x"
  shows "#\<^sub>\<surd>(smap f\<cdot>s) = #\<^sub>\<surd>s"
  using assms
  apply (induction s)
  apply (rule adm_imp)
  apply (rule adm_upward)
  apply (metis sValues_prefix subsetD)
  apply (rule adm_eq)
  apply (simp add: tlen_stream_def; fail)
  apply (intro cont2cont)+
  by simp+

lemma smap_list_tlen:
  fixes f :: "'b::{countable} list \<Rightarrow> 'a::{countable,tlen}"
  assumes "\<And>x. x \<in> sValues\<cdot>(s) \<Longrightarrow> #\<^sub>\<surd>(f x) = 1"
  shows "#\<^sub>\<surd> (smap f\<cdot>(s)) = #(s)"
  apply (insert assms)
  apply (induction s)
  apply (rule adm_imp)
  apply (rule adm_upward)
  using sValues_prefix apply blast
  apply (rule adm_eq)
  apply (simp add: tlen_stream_def; fail)
  apply (intro cont2cont)+
  apply (simp; fail)
  apply (case_tac a; simp)
  using lnat_suc_plus by blast+

lemma tlen_tslice:
  assumes "#s1 < \<infinity>"
  and "\<And>m. m\<in>sValues\<cdot>s1 \<Longrightarrow> #\<^sub>\<surd> m = 0"
