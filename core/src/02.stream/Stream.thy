instantiation stream::("{tlen, countable}") tlen
begin
fixrec tlen_h::"'a::{tlen, countable} stream \<rightarrow> lnat" where
"tlen_h\<cdot>\<epsilon>   = \<bottom>" |
"tlen_h\<cdot>(up\<cdot>msg && rest) = lAdd\<cdot>(tlen (undiscr msg))\<cdot>(tlen_h\<cdot>rest)"

definition tlen_stream::"'a::{tlen, countable} stream \<Rightarrow> lnat" where
"tlen_stream = Rep_cfun tlen_h"

instance
  apply(intro_classes)
  unfolding tlen_stream_def
  apply (meson monofunI monofun_cfun_arg)
  apply(rule exI [where x="\<up>tlen_T"], simp add: sup'_def)
  using lnzero_def plus_lnat0_l tlent ladd_insert by auto
