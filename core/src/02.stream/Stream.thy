
theory Stream
imports inc.Classes inc.Prelude inc.SetPcpo
begin


default_sort countable

 declare One_nat_def[simp del]


text\<open>This chapter introduces a fully functional verification
framework in Isabelle. It is based on FOCUS and build to even be
suitable for untrained users. The verification processes can be
started by using \gls{MontiArc} to define a components behaviour and
additionally the wanted behaviour as a property. Whole systems can
be modeled by composing its sub-components. The \gls{MontiArc} model
of the complete system is then used to transform the \gls{MontiArc}
components into stream processing functions with equivalent
behaviour in the Isabelle framework. General useful properties for
the components are provided in form of already proven lemmas. The
correctness and incorrectness
of the defined property can then be checked by automatic provers.
If wanted, experienced users can also prove the correct behaviour of
their models by hand. If the system consists of more than one
component, the complete system is represented by the composition of
its sub-components.\<close>

                              text\<open>\label{sec:stream}\<close>



domain
  'a stream = lscons (lshd::"'a discr u") (lazy srt::"'a stream")
                                        (infixr "&&" 65)


                                          text\<open>\label{subsec:sfun}\<close>

text\<open>\Cref{tab:streamfun} gives an overview
about the main functions defined for @{type stream}s. Some of them
are introduced in detail for their later usage in the Isabelle
framework. The type \<open>N\<^sub>\<infinity>\<close> representing the natural numbers inclusive
\<open>\<infinity>\<close> is defined as \gls{lnat}. An introduction is in \cite{GR07}.\<close>





abbreviation
  sbot ::  "'a stream"  ("\<epsilon>")
    where "sbot \<equiv> \<bottom>"

text \<open>@{term stake}: This operator is generated by the \<open>domain\<close>
  command. It retrieves the first \<open>n\<close> elements of a stream
  (or less, if the stream is shorter).\<close>
abbreviation
  stake :: "nat \<Rightarrow> 'a stream \<rightarrow> 'a stream"
    where "stake \<equiv> stream_take"



text \<open>@{term sup'}: Construct a stream by a single element.\<close>
definition sup'       :: "'a \<Rightarrow> 'a stream" ("\<up>_" [1000] 999) where
"sup' a \<equiv> updis a && \<epsilon>"

text \<open>@{term sconc}: Concatenate two streams over the same type.
  For infinite streams, arbitrary other streams can be appended
  without changing the stream.\<close>
definition sconc      :: "'a stream \<Rightarrow> 'a stream \<rightarrow> 'a stream" where
"sconc \<equiv> fix\<cdot>(\<Lambda> h. (\<lambda> s1. \<Lambda> s2.
                      if s1 = \<epsilon> then s2 else  (lshd\<cdot>s1) && (h (srt\<cdot>s1)\<cdot>s2)))"

abbreviation sconc_abbr :: "'a stream \<Rightarrow> 'a stream \<Rightarrow> 'a stream" ("(_ \<Zcat> _)" [66,65] 65)
where "s1 \<Zcat> s2 \<equiv> sconc s1\<cdot>s2"


text \<open>@{term shd}: Retrieve the first element of a stream.
  For \<open>\<epsilon>\<close>, the result is not defined.\<close>
definition shd        :: "'a stream \<Rightarrow> 'a" where
"shd s \<equiv> THE a. lshd\<cdot>s = updis a"

text \<open>@{term slookahd}: Apply function to head of stream.
  If the stream is empty, \<open>\<bottom>\<close> is returned.
  This function is especially useful for defining own stream-processing
  functions.\<close>
definition slookahd   :: "'a stream \<rightarrow> ('a \<Rightarrow> 'b) \<rightarrow> ('b::pcpo)" where
"slookahd \<equiv> \<Lambda> s f. if s = \<epsilon> then \<bottom> else f (shd s)"


text \<open>Lists can be converted to streams by the function @{term list2s}:\<close>

primrec list2s :: "'a list \<Rightarrow> 'a stream"
where
  list2s_0:   "list2s [] = \<epsilon>" |
  list2s_Suc: "list2s (a#as) = updis a && (list2s as)"

abbreviation stream_abbrev :: "'a list \<Rightarrow> 'a stream" ("<_>" [1000] 999)
where "<l> == list2s l"

instantiation list :: (countable) po
begin

  definition sq_le_list:
    "s \<sqsubseteq> t \<equiv> (list2s s \<sqsubseteq> list2s t)"

  lemma list2s_inj[simp]: "(list2s l = list2s l') = (l = l')"
  apply (rule iffI)
  apply (simp add: atomize_imp)
  apply (rule_tac x="l'" in spec)
  apply (induct l, simp)
  apply (rule allI)
  apply (induct_tac x, simp+)
  apply (rule allI)
  by (induct_tac x, simp+)

instance
apply (intro_classes)
apply (simp add: sq_le_list)+
apply (rule_tac y="list2s y" in below_trans,assumption+)
apply (simp add: sq_le_list)
apply (rule list2s_inj [THEN iffD1])
by (rule po_eq_conv [THEN iffD2],rule conjI,assumption+)

end




text \<open>@{term slen}: Retrieve the length of a stream. It is defined
as the number of its elements or \<open>\<infinity>\<close> for infinite streams.\<close>

definition slen:: "'a stream \<rightarrow> lnat" where
"slen \<equiv> fix\<cdot>(\<Lambda> h. strictify\<cdot>(\<Lambda> s. lnsuc\<cdot>(h\<cdot>(srt\<cdot>s))))"





instantiation stream :: (countable) len
begin
definition len_stream::"'a stream \<Rightarrow> lnat" where
"len_stream s = slen\<cdot>s"

instance
  apply(intro_classes)
  apply (auto simp add: monofun_def below_prod_def min_def)[1]
  by (metis (mono_tags) cont_pref_eq1I len_stream_def lnle_conv)

end

lemma len_stream_cont[simp, cont2cont]: "cont (\<lambda>s::'a stream. #s)"
  by(simp add: len_stream_def)

lemma len_stream_cont_2: "cont (\<lambda>xa. #(((f x\<cdot>xa))::'a stream))"
  apply (rule cont_compose_mix)
  apply (simp)
  done

lemma slen_zero [simp]: "#\<epsilon> = 0"
   apply(simp add:len_stream_def)
  by(subst slen_def [THEN fix_eq2], simp add: lnzero_def)

text \<open>@{term sdrop}: Remove the first \<open>n\<close> elements
  of the stream.\<close>
definition sdrop      :: "nat \<Rightarrow> 'a stream \<rightarrow> 'a stream" where
"sdrop n \<equiv> Fixrec.iterate n\<cdot>srt"



definition snth :: "nat \<Rightarrow> 'a stream \<Rightarrow> 'a" where
"snth k s \<equiv> shd (sdrop k\<cdot>s)"

text\<open>Obtaining the elements of a stream with @{const snth} is often
used in the verification process of components behaviour.\<close>

text\<open>Discrete Version of @{const snth}\<close>

definition lsnth :: "nat \<Rightarrow> 'a stream \<Rightarrow> 'a discr\<^sub>\<bottom>" where
"lsnth k s \<equiv> lshd\<cdot>(sdrop k\<cdot>s)"




definition sValues :: "'a stream \<rightarrow> 'a set" where
"sValues \<equiv> \<Lambda> s. {snth n s | n. Fin n < #s}"


text\<open>The definition of @{const sValues} is straight forward with the
usage of @{const snth}.\<close>

text \<open>@{term sntimes}: Repeat the given stream \<open>n\<close> times.\<close>

text \<open>@{term sinftimes}: Concatenate a stream infinitely often to itself.\<close>
definition sinftimes  :: "'a stream \<Rightarrow> 'a stream" ("_\<^sup>\<infinity>") where
 "sinftimes \<equiv> fix\<cdot>(\<Lambda> h. (\<lambda>s.
                        if s = \<epsilon> then \<epsilon> else (s \<Zcat> (h s))))"



text \<open>Similar to @{const map} on lists we can define a mapping that
applies a function to each element of a stream. Here,
@{const slookahd} is used to first check if there exists an element
in the input stream. If the stream is empty, the empty stream is
returned, if the stream is not empty, the input function is applied
to the first stream element. Through the usage of the fix point
operator, this element-wise mapping is repeated until each element
was processed.\<close>

definition smap:: "('a \<Rightarrow> 'b) \<Rightarrow> 'a stream \<rightarrow> 'b stream" where
"smap f \<equiv> fix\<cdot>(\<Lambda> h s. slookahd\<cdot>s\<cdot>(\<lambda> a.
                       \<up>(f a) \<Zcat> (h\<cdot>(srt\<cdot>s))))"




text\<open>An automatons semantic can be represented by a @{const smap}
mapping if there is only a self looping state.\<close>



text \<open>@{term szip}: Zip two streams into one stream.\<close>
definition szip       :: "'a stream \<rightarrow> 'b stream \<rightarrow> ('a \<times> 'b) stream" where
 "szip \<equiv> fix\<cdot>(\<Lambda> h s1 s2. slookahd\<cdot>s1\<cdot>(\<lambda> a. slookahd\<cdot>s2\<cdot>(\<lambda> b.
                     \<up>(a,b) \<Zcat> (h\<cdot>(srt\<cdot>s1)\<cdot>(srt\<cdot>s2)))))"


text \<open>@{term sprojfst}: Access the first stream of two zipped streams.\<close>
definition sprojfst   :: "('a\<times>'b) stream \<rightarrow> 'a stream" where
"sprojfst \<equiv> \<Lambda> x. smap fst\<cdot>x"


text \<open>@{term sprojsnd}: Access the second stream of two zipped streams.\<close>
definition sprojsnd   :: "('a\<times>'b) stream \<rightarrow> 'b stream" where
"sprojsnd \<equiv> \<Lambda> x. smap snd\<cdot>x"




text \<open>@{term list2s}: Convert a list to a (finite) stream.\<close>

text \<open>@{term s2list}: Convert a stream to a list. Result for
  infinite streams is undefined.\<close>
definition s2list     :: "'a stream \<Rightarrow> 'a list" where
"s2list s \<equiv> if #s \<noteq> \<infinity> then SOME l. list2s l = s else undefined"






primrec sntimes :: "nat \<Rightarrow> 'a stream \<Rightarrow> 'a stream" where
  "sntimes 0 s = \<epsilon>" |
  "sntimes (Suc n) s = (sconc s)\<cdot>(sntimes n s)"

abbreviation sntimes_abbr :: "nat \<Rightarrow> 'a stream \<Rightarrow> 'a stream" ("_\<star>_" [60,80] 90)
where "(n \<star> s)  == (sntimes n s)"





subsection \<open>Fundamental properties of @{term stake}\<close>

lemmas scases' = stream.exhaust
lemmas sinjects' = stream.injects
lemmas sinverts' = stream.inverts

lemma reach_stream: "(\<Squnion>i. stake i\<cdot>s) = s"
apply (rule stream.take_lemma [OF spec [where x=s]])
apply (induct_tac n, simp, rule allI)
apply (rule_tac y=x in scases', simp)
apply (subst lub_range_shift [where j="Suc 0", THEN sym],simp+)
by (subst contlub_cfun_arg [THEN sym], auto)

lemma gstake2stake: assumes "\<forall>i. stake (i*y)\<cdot>xs = stake (i*y)\<cdot>ys" and "y\<noteq>0"
  shows "\<forall>i. stake i\<cdot>xs = stake i\<cdot>ys"
proof
  fix i
  obtain k where "\<exists>l. k = y*l" and "k\<ge>i" by (metis One_nat_def Suc_le_eq assms(2) gr0I mult.commute mult_le_mono2 nat_mult_1_right)
  thus "stake i\<cdot>xs = stake i\<cdot>ys" by (metis assms(1) min_def mult.commute stream.take_take)
qed

lemma stake_mono: assumes "i\<le>j"
  shows "stake i\<cdot>s \<sqsubseteq> stake j\<cdot>s"
by (metis assms min_def stream.take_below stream.take_take)



lemma shd_single [simp]: "shd (\<up>a) = a"
  by (simp add: shd_def sup'_def)

lemma l2s_single[simp]: "<[a]> = \<up>a"
  by(simp add: sup'_def)

lemma sup_noteps[simp]: "\<up>a \<noteq> \<epsilon>"
by (simp add: sup'_def)

lemma singelton_not_empty: " x = \<up>y \<longrightarrow> x \<noteq> \<epsilon>"
  by simp

lemma srtsup [simp]: "srt\<cdot>(\<up>a) = \<epsilon>"
by (simp add: sup'_def)

lemma reduce_seq:
  assumes "s1 = s2"
  shows "s \<Zcat> s1 = s \<Zcat> s2"
  by (simp add: assms)

lemma sconc_cont[simp] :"cont (\<lambda> h. (\<lambda> s1. \<Lambda> s2.
               if s1 = \<epsilon> then s2 else  (lshd\<cdot>s1) && (h (srt\<cdot>s1)\<cdot>s2)))"
  by(intro cont2cont)


lemma sconc_fst_empty[simp]:"\<epsilon> \<Zcat> s = s"
apply (subst sconc_def [THEN fix_eq2])
by (simp add: cont2cont_LAM)

lemma sconc_scons': "(updis a && as) \<Zcat> s = updis a && (as \<Zcat> s)"
apply (subst sconc_def [THEN fix_eq2])
by (simp add: cont2cont_LAM)

lemma lscons_conv: "updis a && s = \<up>a \<Zcat> s"
apply (subst sconc_def [THEN fix_eq2])
  by (simp add:  sup'_def)

lemma sconc_scons[simp]: "(\<up>a \<Zcat> as) \<Zcat> s = \<up>a \<Zcat> (as \<Zcat> s)"
apply (subst sconc_def [THEN fix_eq2])
by (simp add: sconc_scons' sup'_def cont2cont_LAM)

lemma scases [case_names bottom scons]: "\<And>x P. \<lbrakk>x = \<epsilon> \<Longrightarrow> P; \<And>a s. x = \<up>a \<Zcat> s \<Longrightarrow> P\<rbrakk> \<Longrightarrow> P"
apply (rule_tac y=x in scases', simp+)
apply (rule_tac p=u in upE, simp+)
apply (case_tac "xa")
by (auto simp add: sup'_def sconc_scons')

lemma stake_Suc[simp]: "stake (Suc n)\<cdot>(\<up>a \<Zcat> as) = \<up>a \<Zcat> stake n\<cdot>as"
by (simp add: sconc_scons' sup'_def)

lemma sconc_snd_empty[simp]: "s \<Zcat> \<epsilon> = s"
apply (rule stream.take_lemma [OF spec [where x = "s"]])
apply (induct_tac n, simp)
apply (rule allI, simp)
by (rule_tac x=x in scases, simp+)

lemma shd1[simp]: "shd (\<up>a \<Zcat> s) = a"
by (simp add: sconc_scons' shd_def sup'_def)

lemma lshd_updis [simp]: "lshd\<cdot>(\<up>a \<Zcat> s) = updis a"
by (metis lscons_conv stream.sel_rews(4))

lemma srt_supconc[simp]: "srt\<cdot>(\<up>a\<Zcat>as) = as"
by (simp add: sconc_scons' sup'_def)

lemma supconc_below[simp]: "\<up>a \<sqsubseteq> \<up>a \<Zcat> s"
apply (subst sconc_snd_empty [of "\<up>a", THEN sym])
by (rule monofun_cfun_arg, simp)


lemma updis_eq: "(updis a = updis b) = (a = b)"
by simp

lemma updis_eq2: "(updis a \<sqsubseteq> updis b) = (a = b)"
by simp

lemma inject_scons: "\<up>a \<Zcat> s1 = \<up>b \<Zcat> s2 \<Longrightarrow> a = b \<and> s1 = s2"
apply (subst updis_eq [THEN sym])
apply (rule sinjects' [THEN iffD1], simp)
by (simp add: sconc_scons' sup'_def)

lemma less_all_sconsD: "\<up>a \<Zcat> as \<sqsubseteq> \<up>b \<Zcat> bs \<Longrightarrow> a = b \<and> as \<sqsubseteq> bs"
apply (subst updis_eq2 [THEN sym])
apply (rule sinverts' [THEN iffD1], simp)
by (simp add: sconc_scons' sup'_def)

lemma supconc_neps[simp]: "\<epsilon> \<noteq> \<up>a \<Zcat> as"
apply (rule ccontr, simp)
apply (drule po_eq_conv [THEN iffD1])
apply (erule conjE)
by (simp add: sconc_scons' sup'_def)

lemma supconc_neps2[simp]: "\<up>a \<Zcat> as \<noteq> \<epsilon>"
by (rule notI, drule sym, simp)


lemma sup_eq [simp]: "(\<up>a \<sqsubseteq> \<up>b) = (a = b)"
apply (rule iffI)
by (insert less_all_sconsD [of a \<epsilon> b \<epsilon>], simp+)

lemma slen_conc_below[simp]: "#as \<sqsubseteq> #(as \<Zcat> ys)"
  by (metis minimal monofun_cfun_arg sconc_snd_empty len_stream_def)

lemma sup_eq_iff[simp]: "(\<up>a = \<up>b) = (a = b)"
apply (rule iffI)
by (insert inject_scons [of a \<epsilon> b \<epsilon>], simp+)

lemma sup_conc_eps[simp]: "(\<up>a \<Zcat> x = \<up>c) = (a = c \<and> x = \<epsilon>)"
by (rule iffI, insert inject_scons [of a x c \<epsilon>], simp+)

lemma sup_conc_eps2 [simp]: "(\<up>c = \<up>a \<Zcat> x) = (a = c \<and> x = \<epsilon>)"
by (rule iffI, insert inject_scons [of c \<epsilon> a x], simp+)

lemma sup_concbelow_eps[simp]: "(\<up>a \<Zcat> x \<sqsubseteq> \<up>b) = (a = b \<and> x = \<epsilon>)"
by (rule iffI, insert less_all_sconsD [of a x b \<epsilon>], simp+)

lemma sup_below_eq[simp]: "(\<up>a \<sqsubseteq> \<up>b \<Zcat> x) = (a = b)"
by (rule iffI, insert less_all_sconsD [of a \<epsilon> b x], simp+)

lemma surj_scons: "x\<noteq>\<epsilon> \<Longrightarrow> \<up>(shd x) \<Zcat> (srt\<cdot>x) = x"
by (rule_tac x=x in scases, simp+)

lemma below_shd: "x \<sqsubseteq> y \<and> x \<noteq> \<epsilon> \<Longrightarrow> shd x = shd y"
  by (metis below_bottom_iff less_all_sconsD surj_scons)

lemma below_shd_alt: "x \<sqsubseteq> y \<and> x \<noteq> \<epsilon> \<Longrightarrow> shd y = shd x"
  using below_shd by fastforce

lemma below_shd_conc: "(\<up>a \<Zcat> s) \<sqsubseteq> x \<Longrightarrow> shd x = a"
  by (metis below_shd shd1
      supconc_neps2)



lemma less_fst_sconsD: "\<up>a \<Zcat> as \<sqsubseteq> y \<Longrightarrow> \<exists>ry. y = \<up>a \<Zcat> ry \<and> as \<sqsubseteq> ry"
apply (rule_tac x=y in scases, simp+)
apply (rule_tac x="s" in exI)
by (drule less_all_sconsD, simp)

lemma less_snd_sconsD:
  "x \<sqsubseteq> \<up>a\<Zcat>as \<Longrightarrow> (x = \<epsilon>) \<or> (\<exists>rx. x = \<up>a\<Zcat>rx \<and> rx \<sqsubseteq> as)"
apply (rule_tac x=x in scases, simp+)
apply (rule_tac x="s" in exI)
by (drule less_all_sconsD, simp)

lemma lessD:
  "x \<sqsubseteq> y \<Longrightarrow> (x = \<epsilon>) \<or> (\<exists>a q w. x = \<up>a\<Zcat>q \<and> y = \<up>a\<Zcat>w \<and> q \<sqsubseteq> w)"
apply (rule_tac x=x in scases, simp+)
apply (rule_tac x="a" in exI)
apply (rule_tac x="s" in exI, simp)
by (drule less_fst_sconsD, simp)

lemma lshd_eq: "ts\<sqsubseteq>xs \<Longrightarrow> ts\<noteq>\<bottom> \<Longrightarrow> lshd\<cdot>ts = lshd\<cdot>xs"
  using lessD by fastforce

subsection \<open>@{term slen}\<close>

lemma slen_cont[simp]: "cont(\<lambda> h. strictify\<cdot>(\<Lambda> s. lnsuc\<cdot>(h\<cdot>(srt\<cdot>s))))"
  by(intro cont2cont)


lemma slen_scons[simp]: "#(\<up>a\<Zcat>as) = lnsuc\<cdot>(#as)"
  unfolding len_stream_def
by (subst slen_def [THEN fix_eq2], simp add: lnle_def)

lemma slen_sup[simp]: "#(\<up>a) = Fin (Suc 0)"
apply (subst sconc_snd_empty [of "\<up>a", THEN sym])
by (subst slen_scons, simp+)

lemma inf_scase:"#s = \<infinity> \<Longrightarrow> \<exists>a as. s = \<up>a \<Zcat> as \<and> #as = \<infinity>"
by (rule_tac x=s in scases, auto)

lemma slen_empty_eq[simp]: "(#x = 0) = (x = \<epsilon>)"
by (rule_tac x=x in scases, auto)

lemma sconc_fst_inf_lemma: "\<forall>x. #x=\<infinity> \<longrightarrow> stake n\<cdot>(x\<Zcat>y) = stake n\<cdot>x"
apply (induct_tac n, auto)
by (rule_tac x=x in scases, auto)

lemma sconc_fst_inf[simp]: "#x=\<infinity> \<Longrightarrow> x\<Zcat>y = x"
apply (rule stream.take_lemma)
by (rule sconc_fst_inf_lemma [rule_format])

lemma slen_sconc_all_finite:
  "\<forall>x y n. #x = Fin k \<and> #y = Fin n \<longrightarrow> #(x\<Zcat>y) = Fin (k+n)"
apply (induct_tac k, auto)
by (rule_tac x=x in scases, auto)

lemma mono_fst_infD: "\<lbrakk>#x = \<infinity>; x \<sqsubseteq> y\<rbrakk> \<Longrightarrow> #(y::'a stream) = \<infinity> "
  unfolding len_stream_def
apply (drule monofun_cfun_arg [of _ _ slen])
by (rule lnat_po_eq_conv [THEN iffD1], simp)

text \<open>For @{term "s \<sqsubseteq> t"} with @{term s} and @{term t} of
  equal length, all finite prefixes are identical\<close>
lemma stake_eq_slen_eq_and_less:
  "\<forall>s t. #s = #t \<and> s \<sqsubseteq> t \<longrightarrow> stake n\<cdot>s = stake n\<cdot>t"
apply (induct_tac n, auto)
apply (rule_tac x=s in scases, auto)
apply (rule_tac x=t in scases, auto)
by (drule less_all_sconsD, auto)

text \<open>For @{term "s \<sqsubseteq> t"} with @{term s} and @{term t} of
  equal length, @{term s} and @{term t} are identical\<close>
lemma eq_slen_eq_and_less: "\<lbrakk>#s = #t; s \<sqsubseteq> t\<rbrakk> \<Longrightarrow> (s::'a stream) = t"
apply (rule stream.take_lemma)
by (rule stake_eq_slen_eq_and_less [rule_format], rule conjI)

lemma eq_less_and_fst_inf: "\<lbrakk>s1 \<sqsubseteq> s2; #s1 = \<infinity>\<rbrakk> \<Longrightarrow> (s1::'a stream) = s2"
apply (rule eq_slen_eq_and_less, simp)
apply (rule sym)
by (rule mono_fst_infD [of "s1" "s2"])

lemma len_belowimp[simp]: "Fin n < ln \<Longrightarrow> Fin n < lnsuc\<cdot>(ln)"
  apply (simp add: lnless_def, rule conjI)
  using dual_order.trans less_lnsuc apply blast
  using less2eq by fastforce

lemma slen_stake_fst_inf:
  "\<forall>x. #x = \<infinity> \<longrightarrow> #(stake n\<cdot>x) = Fin n"
apply (induct_tac n, auto)
by (rule_tac x=x in scases, auto)

lemma mono_slen: "x \<sqsubseteq> y \<Longrightarrow> #x \<le> #y"
  by (simp add: mono_len)

lemma slen_rt_ile_eq: "(#x \<le> Fin (Suc n)) = (#(srt\<cdot>x) \<le> Fin n)"
by (rule_tac x=x in scases, auto)

lemma smono_slen_rt_lemma:
  "#x = Fin k \<and> x \<noteq> \<epsilon> \<and> #x < #y \<longrightarrow> #(srt\<cdot>x) < #(srt\<cdot>y)"
apply (induct_tac k, auto)
apply (rule_tac x=x in scases, auto)
by (rule_tac x=y in scases, auto)

lemma smono_slen_rt: "\<lbrakk>x \<noteq> \<epsilon>; #x < #y\<rbrakk> \<Longrightarrow> #(srt\<cdot>x) < #(srt\<cdot>y)"
apply (rule_tac x="#x" in lncases, auto)
by (rule smono_slen_rt_lemma [rule_format], simp)

lemma inf2max: "\<lbrakk>chain Y; #(Y k) = \<infinity>\<rbrakk> \<Longrightarrow> Y k = ((\<Squnion>i. Y i)::'a stream)"
apply (subgoal_tac "Y k \<sqsubseteq> (\<Squnion>i. Y i)")
apply (drule eq_less_and_fst_inf, assumption+)
by (rule is_ub_thelub)

lemma ub_slen_stake[simp]: "#(stake n\<cdot>x) \<le> Fin n"
apply (rule spec [where x = x])
apply (induct_tac n, auto)
by (rule_tac x=x in scases, auto)

lemma slen_stake_fin[simp]: "#(stake n\<cdot>x) \<noteq> \<infinity>"
proof (rule notI)
  assume inf: "#(stake n\<cdot>x) = \<infinity>"
  have "#(stake n\<cdot>x) \<le> Fin n" by (rule ub_slen_stake)
  thus False using inf by simp
qed

lemma fin2stake_lemma: "\<forall>x k. #x = Fin k \<and> k\<le>i \<longrightarrow> stake i\<cdot>x = x"
apply (induct_tac i, auto)
apply (rule_tac x=x in scases, auto)
by (case_tac "k", auto)

lemma fin2stake:"#x = Fin n \<Longrightarrow> stake n\<cdot>x = x"
  by (rule fin2stake_lemma [rule_format, of "x" "n" "n"], simp)

lemma stake2shd:"s\<noteq>\<epsilon> \<Longrightarrow> stake (Suc 0)\<cdot>s = \<up>(shd s)"
  by(rule scases[of s],simp_all add: Nat.One_nat_def)

lemma stake2shd2:"s\<noteq>\<epsilon> \<Longrightarrow> stake 1\<cdot>s = \<up>(shd s)"
  by(simp add: Nat.One_nat_def stake2shd)

lemma srt_decrements_length : "s \<noteq> \<epsilon> \<Longrightarrow> #s = lnsuc\<cdot>(#(srt\<cdot>s))" by (metis slen_scons surj_scons)

lemma srtlen_lnsuc[simp]:"#s=lnsuc\<cdot>n \<Longrightarrow> #(srt\<cdot>s) = n"
  by (metis inject_lnsuc lnsuc_neq_0_rev lnzero_def
      srt_decrements_length slen_zero)

lemma leneq2strict[simp]:assumes"\<And>s. #(spf\<cdot>s) = #s"
  shows"spf\<cdot>\<epsilon> = \<epsilon>"
  apply(rule ccontr)
  apply(subgoal_tac "#(spf\<cdot>\<epsilon>)\<noteq>0")
  apply (simp add: assms; fail)
  by simp

lemma mtoshd[simp]:
  assumes "\<And>s. #(f\<cdot>s) = #s"
  shows"\<up>(shd(f\<cdot>(\<up>m))) = f\<cdot>(\<up>m)"
  using assms
proof-
  obtain x where x_def:"(f\<cdot>(\<up>m)) = x"
    by simp
  then have "#x = 1"
    using assms apply auto[1]
    by (simp add: one_lnat_def)
  then obtain y where y_def: "y= shd x"
    by simp
  then have "shd(f\<cdot>(\<up>m)) = y"
    using x_def by auto
  then show ?thesis
    apply (simp add: x_def)
    by (metis Stream.slen_empty_eq \<open>#x = 1\<close>
        fin2stake lnsuc_neq_0_rev one_def one_lnat_def stake2shd2)
qed


lemma empty_is_shortest : "Fin n < #s \<Longrightarrow> s \<noteq> \<epsilon>" by (metis Fin_0 less_le lnle_Fin_0 slen_zero)

lemma convert_inductive_asm : "Fin (Suc n) < #s \<Longrightarrow> Fin n < #s" by (metis Fin_leq_Suc_leq less_le not_le)

lemma only_empty_has_length_0 : "#s \<noteq> 0 \<Longrightarrow> s \<noteq> \<epsilon>" by simp



lemma stakeind:
  "\<forall>x. (P \<epsilon> \<and> (\<forall>a s. P s \<longrightarrow> P (\<up>a \<Zcat> s))) \<longrightarrow> P (stake n\<cdot>x)"
by (induct_tac n, auto, rule_tac x=x in scases, auto)

lemma finind:
  "\<lbrakk>#x = Fin n; P \<epsilon>; \<And>a s. P s \<Longrightarrow> P (\<up>a \<Zcat> s)\<rbrakk> \<Longrightarrow> P x"
apply (drule fin2stake)
apply (drule sym, erule ssubst)
apply (rule stakeind [rule_format])
apply (rule conjI, assumption)
apply (rule allI)+
by (rule impI, simp)

lemma ind:
  "\<lbrakk>adm P; P \<epsilon>; \<And>a s. P s  \<Longrightarrow> P (\<up>a \<Zcat> s)\<rbrakk> \<Longrightarrow> P x"
apply (unfold adm_def)
apply (erule_tac x="\<lambda>i. stake i\<cdot>x" in allE, auto)
apply (simp add: stakeind; fail)
by (simp add: reach_stream)

lemma finind2: "#s = Fin k \<Longrightarrow> P \<epsilon> \<Longrightarrow> (\<And>t a. #t < \<infinity> \<Longrightarrow> P t \<Longrightarrow> P (\<up>a \<Zcat> t)) \<Longrightarrow> P s"
proof -
  assume "#s = Fin k" and "P \<epsilon>" and "\<And>t a. #t < \<infinity> \<Longrightarrow> P t \<Longrightarrow> P (\<up>a \<Zcat> t)"
  then show "P s"
  proof (induction k arbitrary: s)
    case 0
    then show ?case
      by auto
  next
    case (Suc k)
    then obtain a t where "s = \<up>a \<Zcat> t" and "#t = Fin k"
      by (metis Fin_Suc bot_is_0 lnat.con_rews lnat.sel_rews(2) slen_empty_eq srt_decrements_length surj_scons)
    then show ?case
      by (simp add: Suc.IH Suc.prems(2) Suc.prems(3))
  qed
qed

lemma finind3: "#s < \<infinity> \<Longrightarrow> P \<epsilon> \<Longrightarrow> (\<And>t a. #t < \<infinity> \<Longrightarrow> P t \<Longrightarrow> P (\<up>a \<Zcat> t)) \<Longrightarrow> P s"
  by (metis finind2 less_le ninf2Fin)

subsection \<open>Other properties of @{term stake}\<close>

lemma stakeostake[simp]: "stake k\<cdot>(stake n\<cdot>x) = stake (min k n)\<cdot>x"
apply (rule_tac x="n" in spec)
apply (rule_tac x="k" in spec)
apply (rule ind [of _ x], simp+)
apply (rule allI)+
apply (case_tac "xa", simp+)
by (case_tac "x", simp+)

lemma ub_stake[simp]: "stake n\<cdot>x \<sqsubseteq> x"
by (rule stream.take_below)

lemma stake_suc: "stake (Suc n)\<cdot>s = (stake 1\<cdot>s) \<Zcat> stake n\<cdot>(srt\<cdot>s)"
by (metis (no_types, lifting) One_nat_def Rep_cfun_strict1 sconc_snd_empty stake_Suc stream.sel_rews(2) stream.take_0 stream.take_strict surj_scons)

lemma stake_below: "(\<And>n::nat. stake n\<cdot>x \<sqsubseteq> stake n\<cdot>y) \<Longrightarrow> x \<sqsubseteq> y"
  apply (case_tac "#x")
  apply (metis fin2stake rev_below_trans stream.take_below)
  by (metis (mono_tags, opaque_lifting) below_refl eq_slen_eq_and_less inf_belowI mono_len2 rev_below_trans slen_stake_fst_inf stream.take_below stream.take_lemma)

lemma eq_Suc_0_numeral1: "Suc 0 = 1"
  by simp

lemma stake_num1_singelton: "stake 1\<cdot>(\<up>x) =\<up>x"
  by (metis sconc_snd_empty
     stake_suc stream.con_rews(2)
     stream.sel_rews(2)
     stream.sel_rews(5)
     stream.take_rews
     sup'_def)

lemma stake_Suc0_singelton:  "stake (Suc 0)\<cdot>(\<up>x) =\<up>x"
  apply (simp only: eq_Suc_0_numeral1)
  by (metis sconc_snd_empty
     stake_suc stream.con_rews(2)
     stream.sel_rews(2)
     stream.sel_rews(5)
     stream.take_rews
     sup'_def)

subsection \<open>@{term sdrop}\<close>

text \<open>basic properties of @{term sdrop}\<close>

lemma strict_sdrop[simp]: "sdrop n\<cdot>\<epsilon> = \<epsilon>"
by (simp add: sdrop_def, induct_tac n, auto)

lemma sdrop_0[simp]: "sdrop 0\<cdot>s = s"
by (simp add: sdrop_def)

lemma sdrop_back_rt: "sdrop (Suc n)\<cdot>s = srt\<cdot>(sdrop n\<cdot>s)"
by (simp add: sdrop_def)

lemma sdrop_forw_rt: "sdrop (Suc n)\<cdot>s = sdrop n\<cdot>(srt\<cdot>s)"
apply (simp add: sdrop_def)
by (subst iterate_Suc2 [THEN sym], simp)

lemma sdrop_scons[simp]: "sdrop (Suc n)\<cdot>(\<up>a \<Zcat> as) = sdrop n\<cdot>as"
by (simp add: sdrop_forw_rt)

lemma sdrop_stakel1: "\<forall>s. sdrop n\<cdot>s = \<epsilon> \<longrightarrow> stake n\<cdot>s = s"
apply (induct_tac n, auto)
by (rule_tac x=s in scases, auto)

lemma sdrop_plus: "sdrop (k+x)\<cdot>xs = sdrop k\<cdot>(sdrop x\<cdot>xs)"
by (simp add: iterate_iterate sdrop_def)

lemma fair_sdrop:
  "\<forall>x. #x = \<infinity> \<longrightarrow> #(sdrop n\<cdot>x) = \<infinity>"
apply (induct_tac n, simp, clarify)
by (rule_tac x=x in scases, auto)

text \<open>streams can be split by @{term stake} and @{term sdrop}\<close>
lemma split_streaml1[simp]:
  "stake n\<cdot>s \<Zcat> sdrop n\<cdot>s = s"
apply (rule spec [where x = s])
apply (induct_tac n, auto)
by (rule_tac x=x in scases, auto)

text \<open>@{term sdrop} may only create infinite outputs for infinite inputs\<close>
lemma fair_sdrop_rev:
  "#(sdrop k\<cdot>x) = \<infinity> \<Longrightarrow> #x = \<infinity>"
apply (simp add: atomize_imp)
apply (rule_tac x="x" in spec)
apply (induct_tac k, simp)
apply (rule allI, rule impI)
apply (rule_tac x="x" in scases, simp)
by (erule_tac x="s" in allE, simp)

text \<open>construct @{term "sdrop j"} from @{term "sdrop k"} (with @{term "j \<le> k"})\<close>
lemma sdropl5:
  "j \<le> k \<Longrightarrow> sdrop j\<cdot>(stake k\<cdot>x) \<Zcat> sdrop k\<cdot>x = sdrop j\<cdot>x"
apply (simp add: atomize_imp)
apply (rule_tac x="j" in spec)
apply (rule_tac x="x" in spec)
apply (induct_tac k, auto)
apply (rule_tac x="x" in scases, auto)
by (case_tac "xa", auto)

lemma sdropl6:
  "#x = Fin k \<Longrightarrow> sdrop k\<cdot>(x \<Zcat> y) = y"
apply (simp add: atomize_imp)
apply (rule_tac x="x" in spec)
apply (rule_tac x="y" in spec)
apply (induct_tac k, auto)
by (rule_tac x="xa" in scases, auto)

lemma srt_drop : "srt\<cdot>(sdrop n\<cdot>s) = sdrop (Suc n)\<cdot>s" by (simp add: sdrop_back_rt)

lemma drop_not_all : "Fin n < #s \<Longrightarrow> sdrop n\<cdot>s \<noteq> \<epsilon>"
proof (induct n)
  show "Fin 0 < #s \<Longrightarrow> sdrop 0\<cdot>s \<noteq> \<epsilon>" by auto

  have "\<And> n. Fin n < #s \<Longrightarrow> #(sdrop n\<cdot>s) = lnsuc\<cdot>(#(srt\<cdot>(sdrop n\<cdot>s)))" by (metis not_le sdrop_stakel1 srt_decrements_length ub_slen_stake)
  hence "\<And> n. Fin n < #s \<Longrightarrow> sdrop n\<cdot>s \<noteq> \<epsilon>" using only_empty_has_length_0 by fastforce
  thus "\<And> n. (Fin n < #s \<Longrightarrow> sdrop n\<cdot>s \<noteq> \<epsilon>) \<Longrightarrow> Fin (Suc n) < #s \<Longrightarrow> sdrop (Suc n)\<cdot>s \<noteq> \<epsilon>" by simp
qed


subsection \<open>@{term snth}\<close>

text \<open>Basic properties of @{term snth}\<close>

lemma snth_rt: "snth (Suc k) s = snth k (srt\<cdot>s)"
apply (simp add: snth_def)
by (subst sdrop_forw_rt,rule refl)

lemma snth_scons[simp]: "snth (Suc k) (\<up>a \<Zcat> s) = snth k s"
by (simp add: snth_rt)

lemma snth_shd[simp]: "snth 0 s = shd s"
by (simp add: snth_def)

lemma snths_eq_lemma :
  "\<forall>x y. #x = #y \<and> (\<forall>n. Fin n < #x \<longrightarrow> snth n x = snth n y)
           \<longrightarrow> stake k\<cdot>x = stake k\<cdot>y"
apply (induct_tac k, auto)
apply (rule_tac x=x in scases, auto)
apply (rule_tac x=y in scases, auto)
apply (erule_tac x="s" in allE)
apply (erule_tac x="sa" in allE, auto)
apply (erule_tac x="Suc na" in allE, simp)
by (erule_tac x="0" in allE, auto)

lemma snths_eq:
  "\<lbrakk>#x = #y; \<forall>n. Fin n < #x \<longrightarrow> snth n x = snth n y\<rbrakk> \<Longrightarrow> x = y"
apply (rule stream.take_lemma)
by (rule snths_eq_lemma[rule_format], auto)

lemma sinf_snt2eq: assumes "#s=\<infinity>" and "#x=\<infinity>" and "\<And>i. (snth i s = snth i x)"
  shows "s=x"
by (simp add: assms snths_eq)

lemma snthp_shd: assumes"\<And>n.  P(snth n s)"
  shows"P(shd s)"
  by (metis assms snth_shd)

lemma snthp_shd2:  assumes"\<And>n.  P(snth n (\<up>m \<Zcat> s))"
  shows"P(m)"
  by (metis assms shd1 snth_shd)

lemma snthp_snth: assumes"\<And>n.  P(snth n (\<up>m \<Zcat> s))"
      shows"P(snth n(s))"
  by (metis assms snth_scons)

lemma snthp_srt:  assumes"\<And>n. P(snth n (s))"
      shows"P(snth n(srt\<cdot>s))"
  by (metis assms snth_rt)

lemma snth_less: "\<lbrakk>Fin n < #x; x \<sqsubseteq> y\<rbrakk> \<Longrightarrow> snth n x = snth n y"
apply (simp add: atomize_imp)
apply (rule_tac x="x" in spec)
apply (rule_tac x="y" in spec)
apply (induct_tac n, auto)
  by (drule lessD, auto)+

lemma snth_sdrop: "snth i (sdrop j\<cdot>x) = snth (i+j) x"
by (simp add: sdrop_plus snth_def)

lemma sntimes_Minus: "n>0 \<Longrightarrow> n\<star>\<up>a = \<up>a\<Zcat>((n-1)\<star>\<up>a)" 
  apply (induction n)
apply (simp; fail)
  by (metis diff_Suc_1' eq_Suc_0_numeral1 Stream.sntimes.simps(2))


subsection \<open>@{term lsnth}\<close>

text \<open>Basic properties of @{term lsnth}\<close>

lemma lsnth_strict[simp]: "lsnth n \<epsilon> = \<bottom>"
  by (simp add: lsnth_def)

lemma lsnth_rt: "lsnth (Suc k) s = lsnth k (srt\<cdot>s)"
apply (simp add: lsnth_def)
by (subst sdrop_forw_rt,rule refl)

lemma lsnth_scons[simp]: "lsnth (Suc k) (\<up>a \<Zcat> s) = lsnth k s"
  by (simp add: lsnth_rt)

lemma lsnth_lshd[simp]: "lsnth 0 s = lshd\<cdot>s"
  by (simp add: lsnth_def)

lemma lsnth_snth_eq:
  assumes "Fin n < #s"
  shows  "lsnth n s = updis (snth n s)"
  apply (simp add: lsnth_def snth_def)
  by (metis assms drop_not_all lshd_updis surj_scons)

lemma lsnth_stake_eq:
  assumes "(\<And>n::nat. lsnth n i = lsnth n out)"
  shows "stake n\<cdot>i = stake n\<cdot>out"
  using assms proof (induction n arbitrary: i out)
  case 0
  then show ?case by auto
  next
  case (Suc n)
  show ?case
    apply (rule_tac x=i in scases)
    apply (rule_tac x=out in scases,simp_all)
    apply (insert Suc.prems [where n=0])
    apply simp_all
    apply (rule_tac x=out in scases,simp_all)
    apply (insert Suc.IH [of s sa for s sa])
    apply (insert Suc.prems)
    by (metis lsnth_scons)
  qed

lemma lsnth_eq:
  assumes "\<And>n. lsnth n x = lsnth n y"
  shows "x = y"
  apply (rule stream.take_lemma)
  using assms lsnth_stake_eq by blast


lemma assoc_sconc[simp]: "(s1\<Zcat>s2)\<Zcat>s3 = s1\<Zcat>s2\<Zcat>s3"
apply (rule_tac x="#s1" in lncases, auto)
by (rule finind [of "s1"], auto)

lemma stake_conc_split:"stake (Suc i)\<cdot>s =(stake i\<cdot>s) \<Zcat> (stake 1\<cdot>(sdrop i\<cdot>s)) "
  apply (induction i arbitrary: s)
   apply (simp add: One_nat_def)
  by (metis assoc_sconc sdrop_forw_rt stake_suc)

lemma stake_conc: "stake i\<cdot>s \<Zcat> x = stake (Suc i)\<cdot>s \<Longrightarrow> x = stake 1\<cdot>(sdrop i\<cdot>s)"
  apply (induction i arbitrary: s x)
  apply (simp add: One_nat_def; fail)
  apply(rule_tac x="s" in scases;simp)
  using inject_scons by blast

lemma stake_concat:"stake i\<cdot>s \<Zcat> stake (Suc j)\<cdot>(sdrop i\<cdot>s) = stake (Suc i)\<cdot>s \<Zcat> stake j\<cdot>(sdrop (Suc i)\<cdot>s)"
  by (metis assoc_sconc stake_conc_split sdrop_back_rt stake_suc)

lemma stake_add: "stake (i+j)\<cdot>s = (stake i\<cdot>s) \<Zcat> (stake j\<cdot>(sdrop i\<cdot>s))"
apply (induction i arbitrary: j)
apply (simp; fail)
by (metis add_Suc_shift stake_concat)

lemma inject_sconc: "\<lbrakk>#x = Fin k; x \<Zcat> y = x \<Zcat> z\<rbrakk> \<Longrightarrow> y = z"
apply (simp add: atomize_imp)
apply (rule_tac x=x in spec)
apply (induct_tac k, auto)
apply (rule_tac x=x in scases, auto)
by (drule inject_scons, auto)

lemma sconc_inj: assumes "#s < \<infinity>"
  shows "inj (Rep_cfun (sconc s))"
  by (meson assms injI inject_sconc lnat_well_h2)

lemma sconc_inj':
  assumes "\<up>a \<Zcat> u = \<up>a \<Zcat> v"
  shows   "u = v"
  using assms by (metis srt_supconc)

lemma sconc_prefix [simp]: "x \<sqsubseteq> x \<Zcat> y"
apply (rule_tac x="#x" in lncases, auto)
apply (rule finind [of x], auto)
by (rule monofun_cfun_arg)

lemma slen_sconc_snd_inf: "#y=\<infinity> \<Longrightarrow> #(x \<Zcat> y) = \<infinity>"
apply (rule_tac x="#x" in lncases, auto)
by (rule finind [of "x"], auto)

lemma sdropostake: "sdrop n\<cdot>(stake n\<cdot>s) = \<epsilon>"
apply (rule spec [where x = n])
apply (rule ind [of _ s], auto)
by (case_tac x, auto)

lemma stakeind2:
  "\<forall>x. (P \<epsilon> \<and> (\<forall>a s. P s \<longrightarrow> P (s \<Zcat> \<up>a))) \<longrightarrow> P (stake n\<cdot>x)"
  apply(induction n)
   apply (simp; fail)
  apply auto[1]
  apply (subst stake_suc)
  by (metis (no_types, lifting) sconc_snd_empty sdrop_back_rt sdropostake split_streaml1 stake_suc surj_scons)

lemma ind2: assumes "adm P" and "P \<epsilon>"  and "\<And>a s. P s  \<Longrightarrow> P (s \<Zcat> \<up>a)"
  shows "P x"
by (metis assms(1) assms(2) assms(3) stakeind2 stream.take_induct)

lemma stream_fin_induct: assumes Bot: "P \<bottom>" and lscons: "(\<And>x xs. x\<noteq>\<bottom>\<Longrightarrow>P xs \<Longrightarrow> P (x&&xs))" and fin: "#xs<\<infinity>"
  shows "P xs"
  by (metis finind infI lnless_def sconc_fst_empty sconc_scons' sup'_def up_defined assms)

lemma stream_infs: "(\<And>s::'a stream. #s<\<infinity> \<Longrightarrow> P s) \<Longrightarrow> adm P \<Longrightarrow> P s"
  by (metis inf_less_eq leI notinfI3 slen_stake_fst_inf stream.take_induct)

lemma slen_stake: "#s \<ge> Fin n \<Longrightarrow> #(stake n\<cdot>s) = Fin n"
proof (induction n)
  case 0
  then show ?case
    by simp
next
  case (Suc n)
  assume "#s \<ge> Fin (Suc n)"
  then have "#s \<ge> Fin n"
    by (simp add: Suc.prems Fin_leq_Suc_leq)
  obtain r where "stake (Suc n)\<cdot>s = (stake n\<cdot>s) \<Zcat> r"
    by (metis (no_types) Rep_cfun_strict1 sconc_snd_empty stake_concat stream.take_0)
  then have "r \<noteq> \<epsilon>"
    by (metis (mono_tags, lifting) Fin_02bot Fin_Suc One_nat_def Suc.prems \<open>Fin n \<le> #s\<close> bot_is_0 drop_not_all inject_Fin lnle_def lnless_def n_not_Suc_n only_empty_has_length_0 sdropostake slen_scons srt_drop stake_Suc stake_conc strictI surj_scons)
  have "#((stake n\<cdot>s) \<Zcat> r) \<ge> Fin (Suc n)"
  proof -
    have f1: "#(stake n\<cdot>s) = Fin n"
      using Suc.IH \<open>Fin n \<le> #s\<close> by fastforce
    have f2: "\<forall>s sa. (sa::'a stream) \<sqsubseteq> sa \<Zcat> s"
      by simp
    have "\<exists>n. stake n\<cdot>s \<Zcat> r \<noteq> stake n\<cdot>s \<and> Fin n = Fin n"
      using f1 by (metis \<open>r \<noteq> \<epsilon>\<close> inject_sconc sconc_snd_empty)
    then have "#(stake n\<cdot>s \<Zcat> r) \<noteq> Fin n"
      by (metis Suc.IH \<open>Fin n \<le> #s\<close> \<open>r \<noteq> \<epsilon>\<close> fin2stake sdropl6 sdropostake)
    then show ?thesis
      using f2 f1 by (metis (no_types) less2lnleD lnless_def mono_len lnle_def)
  qed
  then show ?case
    by (metis \<open>stake (Suc n)\<cdot>s = stake n\<cdot>s \<Zcat> r\<close> dual_order.antisym ub_slen_stake)
qed

lemma sdrop_split:
  assumes "n \<le> #as"
  shows "sdrop n\<cdot>(as \<Zcat> bs) = sdrop n\<cdot>as \<Zcat> bs"
  by (metis (no_types, lifting) assms assoc_sconc sdropl6 slen_stake split_streaml1)


text \<open>A finite prefix of length @{term "k"} is created by @{term "stake k"}\<close>
lemma approxl1:
  "\<forall>s1 s2. s1 \<sqsubseteq> s2 \<and> #s1 = Fin k \<longrightarrow> stake k\<cdot>s2 = s1"
apply (induct_tac k, auto)
apply (rule_tac x=s1 in scases, auto)
apply (rule_tac x=s2 in scases, auto)
apply (erule_tac x="s" in allE)
apply (erule_tac x="sa" in allE)
by (drule less_all_sconsD, auto)

lemma approxl2:
  "s1 \<sqsubseteq> s2 \<Longrightarrow> (s1 = s2) \<or> (\<exists>n. stake n\<cdot>s2 = s1 \<and> Fin n = #s1)"
apply (rule_tac x="#s1" in lncases, auto)
apply (rule eq_less_and_fst_inf, assumption+)
by (insert approxl1
  [rule_format, of "s1" "s2"], auto)

lemma inf_chainl1:
  fixes Y::"nat \<Rightarrow> 'a stream"
  shows"\<lbrakk>chain Y; \<not>finite_chain Y\<rbrakk> \<Longrightarrow> \<exists>k. #(Y i) = Fin k"
apply (rule ccontr, simp, frule infI)
apply (frule_tac k="i" in inf2max, assumption)
apply (frule_tac i="i" in max_in_chainI3, simp+)
by (simp add: finite_chain_def)

lemma approxl3: "s1 \<sqsubseteq> s2 \<Longrightarrow> \<exists>t. s1\<Zcat>t = s2"
apply (rule_tac x="#s1" in lncases, simp)
apply (drule eq_less_and_fst_inf, simp+)
apply (subst approxl1
  [rule_format, of "s1" "s2", THEN sym], simp+)
by (rule_tac x="sdrop k\<cdot>s2" in exI, simp)

lemma mstoshd[simp]:
  assumes "\<And>s. #(f\<cdot>s) = #s"
  shows"\<up>(shd(f\<cdot>(\<up>m \<Zcat> s))) = f\<cdot>(\<up>m)"
proof-
  obtain a s2 where stream_def:"f\<cdot>(\<up>m \<Zcat> s) = \<up>a \<Zcat> s2"
    using scases assms
    by (metis lnat.con_rews lnzero_def only_empty_has_length_0
        slen_scons)
  then have "f\<cdot>(\<up>m) \<sqsubseteq> \<up>a \<Zcat> s2"
    by (metis monofun_cfun_arg sconc_prefix)
  then have "f\<cdot>(\<up>m) = \<up>a"
    using assms
    by (metis approxl3 mtoshd shd1)
  then show ?thesis
    by (simp add: stream_def)
qed

lemma inf_chainl2:
    fixes Y::"nat \<Rightarrow> 'a stream"
    shows "\<lbrakk>chain Y; \<not> finite_chain Y\<rbrakk> \<Longrightarrow> \<exists>j. Y k \<sqsubseteq> Y j \<and> #(Y k) < #(Y j)"
apply (auto simp add: finite_chain_def max_in_chain_def)[1]
apply (erule_tac x="k" in allE, auto)
apply (frule_tac i=k and j=j in chain_mono, assumption)
apply (rule_tac x="j" in exI, simp)
apply (auto simp add: lnless_def)[1]
apply (rule mono_slen, assumption)
by (frule eq_slen_eq_and_less, simp+)

lemma inf_chainl3:
    fixes Y::"nat \<Rightarrow> 'a stream"
  shows "chain Y \<and> \<not>finite_chain Y \<longrightarrow> (\<exists>k. Fin n \<le> #(Y k))"
apply (induct_tac n, auto)
apply (case_tac "Fin n = #(Y k)")
apply (frule_tac k=k in inf_chainl2, auto)
apply (rule_tac x="j" in exI)
apply (drule sym)
apply (rule_tac x="#(Y j)" in lncases, auto)
apply (rule_tac x="k" in exI)
by (rule_tac x="#(Y k)" in lncases, auto)

lemma inf_chainl4:
    fixes Y::"nat \<Rightarrow> 'a stream"
  shows "\<lbrakk>chain Y; \<not>finite_chain Y\<rbrakk> \<Longrightarrow> #(lub(range Y)) = \<infinity>"
apply (rule_tac x="#(Lub Y)" in lncases, auto)
apply (frule_tac n = "Suc k" in inf_chainl3
  [rule_format, OF conjI], assumption, erule exE)
apply (subgoal_tac "Y ka \<sqsubseteq> (Lub Y)")
apply (drule mono_len2, simp)
apply (frule_tac x = "Fin (Suc k)" and
  y = "#(Y ka)" and z = "Fin k" in trans_lnle, simp+)
by (rule is_ub_thelub)

text \<open>Each chain becomes finite by mapping @{term "stake n"} to every element\<close>
lemma finite_chain_stake:
  "chain Y \<Longrightarrow> finite_chain (\<lambda>i. stake n\<cdot>(Y i))"
apply (frule ch2ch_Rep_cfunR [of _ "stake n"])
apply (rule ccontr)
apply (frule inf_chainl4 [of "\<lambda>i. stake n\<cdot>(Y i)"],assumption)
by (simp add: contlub_cfun_arg [THEN sym])

lemma lub_approx:
  "chain Y \<Longrightarrow> \<exists>k. stake n\<cdot>(lub (range Y)) = stake n\<cdot>(Y k)"
apply (subst contlub_cfun_arg, assumption)
apply (frule finite_chain_stake [of _ n])
apply (simp add: finite_chain_def, auto)
apply (rule_tac x="i" in exI)
by (rule lub_finch1
  [THEN lub_eqI, of "\<lambda>i. stake n\<cdot>(Y i)"], auto)

text \<open>If @{term f} is monotone and for each @{term x} there is a finite prefix
  @{term y} such that @{term "f x = f y"}, @{term f} is continuous\<close>
lemma pr_contI:
  "\<lbrakk>monofun f; \<forall>x.\<exists>n. (f x) = f (stake n\<cdot>x)\<rbrakk> \<Longrightarrow> cont f"
apply (rule contI2, assumption)
apply (erule_tac x="lub (range Y)" in allE, erule exE)
apply (frule_tac n = n in lub_approx, erule exE)
apply (subgoal_tac "f (stake n\<cdot>(Y k)) \<sqsubseteq> f (Y k)")
apply (subgoal_tac "f (Y k) \<sqsubseteq> (\<Squnion>i. f (Y i))")
apply (drule_tac x="f (stake n\<cdot>(Y k))" and
  y="f (Y k)" and z = "\<Squnion>i. f (Y i)" in below_trans)
apply (rule is_ub_thelub)
apply (rule_tac f=f in ch2ch_monofun, assumption+)
apply (clarsimp)
apply (rule is_ub_thelub)
apply (rule_tac f=f in ch2ch_monofun, assumption+)
by (rule_tac f = f in monofunE, simp+)

text \<open>For continuous functions, each finite prefix of @{term "f\<cdot>x"} only
  depends on a finite prefix of @{term "x"}\<close>
lemma fun_approxl1:
  "\<exists>j. stake k\<cdot>(f\<cdot>x) = stake k\<cdot>(f\<cdot>(stake j\<cdot>x))"
apply (subgoal_tac "f\<cdot>x = (\<Squnion>i. f\<cdot>(stake i\<cdot>x))")
apply (erule ssubst)
apply (rule lub_approx)
apply (rule chain_monofun)
apply (rule ch2ch_Rep_cfunL)
apply (rule stream.chain_take; fail)
apply (subst contlub_cfun_arg [THEN sym])
apply (rule ch2ch_Rep_cfunL)
apply (rule stream.chain_take; fail)
apply (subst reach_stream)
by (rule refl)

text \<open>For continuous functions, any finite output for stream @{term "x"} can also be
  obtained by some finite prefix of @{term "x"}\<close>
lemma fun_approxl2: "slen\<cdot>(f\<cdot>x) = Fin k \<Longrightarrow> \<exists>j. f\<cdot>x = f\<cdot>(stake j\<cdot>x)"
apply (insert fun_approxl1 [of k "f" x], auto)
  apply (rule_tac x="j" in exI)
  unfolding len_stream_def[symmetric]
apply (frule fin2stake [THEN sym], simp)
apply (rule stream.take_lemma, simp)
apply (case_tac "n \<le> k")
apply (simp add: min_def)+
apply (rule po_eq_conv [THEN iffD2])
apply (rule conjI)
apply (rule monofun_cfun_fun)
apply (rule chain_mono)
apply (rule stream.chain_take, simp+)
apply (subgoal_tac "f\<cdot>(stake j\<cdot>x) \<sqsubseteq> f\<cdot>x")
apply (rule below_trans, auto)
apply (drule sym, drule sym, simp)
by (rule monofun_cfun_arg, simp)

lemma sconc_neq_h: assumes "s1 \<noteq> s2"
  shows "#a < \<infinity> \<longrightarrow> a \<Zcat> s1 \<noteq> a \<Zcat> s2"
  apply(rule ind [of _a ])
    apply(rule admI)
    apply (rule impI)
    apply (metis inf_chainl4 l42 neq_iff)
   apply (simp add: assms; fail)
  by (metis inf_ub inject_scons less_le sconc_scons slen_sconc_snd_inf)

lemma sconc_neq: assumes "s1 \<noteq> s2" and "#a < \<infinity>"
  shows "a \<Zcat> s1 \<noteq> a \<Zcat> s2"
using assms(1) assms(2) sconc_neq_h by blast

lemma stake_prefix: "#s < \<infinity> \<Longrightarrow> t \<noteq> \<epsilon> \<Longrightarrow> s = t \<Zcat> u \<Longrightarrow> \<exists>k. t = stake (Suc k)\<cdot>s"
proof -
  assume "#s < \<infinity>" and "t \<noteq> \<epsilon>" and "s = t \<Zcat> u"
  then obtain k where "t = stake k\<cdot>s"
    by (metis approxl2 fin2stake inf_less_eq minimal monofun_cfun_arg ninf2Fin not_le sconc_snd_empty)
  then obtain l where "k = Suc l"
    by (metis Rep_cfun_strict1 \<open>t \<noteq> \<epsilon>\<close> not0_implies_Suc stream.take_0)
  thus ?thesis
    using \<open>t = stake k\<cdot>s\<close> by blast
qed

lemma stake_prefix2: "#s = Fin n \<Longrightarrow> s = stake n\<cdot>(s \<Zcat> t)"
  by (metis approxl1 minimal monofun_cfun_arg sconc_snd_empty)

lemma slen_conc: "#s < \<infinity> \<Longrightarrow> t \<noteq> \<epsilon> \<Longrightarrow> #s \<ge> Fin n \<Longrightarrow> #(s \<Zcat> t) > Fin n"
  by (metis (no_types, opaque_lifting) stake_prefix2 infI less_le less_le_trans mono_slen sconc_neq sconc_snd_empty stream.take_below)

lemma stake_srt_conc [simp]: "srt\<cdot>((stake 1\<cdot>s)\<Zcat>(s)) = s"
  apply (cases s)
  apply (simp; fail)
  by (metis One_nat_def Rep_cfun_strict1 lscons_conv sconc_snd_empty stake_Suc stream.con_rews(2) stream.sel_rews(5) stream.take_0 surj_scons)


subsection \<open>@{term slookahd}\<close>

text \<open>@{term slookahd} is continuous\<close>
lemma cont_slookahd[simp]: "cont (\<lambda> s. if s=\<epsilon> then \<bottom> else eq (shd s))"
apply (rule pr_contI)
apply (rule monofunI, auto)
apply (rule_tac x=x in scases, auto)
apply (rule_tac x=y in scases, auto)
apply (drule less_all_sconsD, simp)
apply (rule_tac x=x in scases, auto)
by (rule_tac x="Suc 0" in exI, auto)

lemma strict_slookahd[simp]: "slookahd\<cdot>\<epsilon>\<cdot>eq = \<bottom>"
by (simp add: slookahd_def cont2cont_LAM)

lemma slookahd_scons[simp]: "s\<noteq>\<epsilon> \<Longrightarrow> slookahd\<cdot>s\<cdot>eq = eq (shd s)"
by (simp add: slookahd_def cont2cont_LAM)

lemma strict2_slookahd[simp]: "slookahd\<cdot>xs\<cdot>(\<lambda>y. \<epsilon>) = \<epsilon>"
by (cases xs, simp_all)


subsection \<open>@{term sinftimes}\<close>

text \<open>basic properties of @{term sntimes} and @{term sinftimes}\<close>

lemma sinftimes_cont[simp]:"cont(\<lambda> h. (\<lambda>s.
                        if s = \<epsilon> then \<epsilon> else (s \<Zcat> (h s))))"
  by(intro cont2cont)

lemma sntimes_eps[simp]: "sntimes n \<epsilon> = \<epsilon>"
by (induct_tac n, simp+)

lemma shd_sntime [simp]: assumes "n>0" shows "shd (n \<star> \<up>s) = s"
by (metis assms gr0_implies_Suc shd1 sntimes.simps(2))

lemma strict_icycle[simp]: "sinftimes \<epsilon> = \<epsilon>"
by (subst sinftimes_def [THEN fix_eq2], auto)

lemma sinftimes_unfold: "sinftimes s = s \<Zcat> sinftimes s"
by (subst sinftimes_def [THEN fix_eq2], auto)

text \<open>For nonempty @{term s}, @{term "sinftimes s"} is infinite\<close>
lemma slen_sinftimes: "s \<noteq> \<epsilon> \<Longrightarrow> #(sinftimes s) = \<infinity>"
apply (rule ccontr)
apply (rule_tac x="#(sinftimes s)" in lncases, auto)
apply (rule_tac x="#s" in lncases)
apply (insert sinftimes_unfold [of s], auto)
by (insert slen_sconc_all_finite
  [rule_format, of "s" _ "sinftimes s"], force)

lemma slen_sup_sinftimes[simp]: "#(sinftimes (\<up>a)) = \<infinity>"
by (simp add: slen_sinftimes)

lemma lshd_sinf [simp]: "lshd\<cdot>\<up>x\<^sup>\<infinity> = updis x"
by (metis lshd_updis sinftimes_unfold)

lemma shd_sinf[simp]: "shd (x\<^sup>\<infinity>) = shd x"
by (metis assoc_sconc shd1 sinftimes_unfold strict_icycle surj_scons)

lemma srt_sinf [simp]: "srt\<cdot>\<up>x\<^sup>\<infinity> = ((\<up>x)\<^sup>\<infinity>)"
by (metis lscons_conv sinftimes_unfold stream.sel_rews(5) up_defined)

lemma stake_y [simp]: assumes "#x = Fin y"
    shows "stake y\<cdot>(sinftimes x) = x"
by (metis approxl1 assms minimal monofun_cfun_arg sconc_snd_empty sinftimes_unfold)

lemma snth_sinftimes[simp]: "snth i ((\<up>s)\<^sup>\<infinity>) = s"
apply (induction i)
apply (simp)
by (simp add: snth_rt)

lemma sdrops_sinf[simp]: "sdrop i\<cdot>((\<up>x)\<^sup>\<infinity>) = ((\<up>x)\<^sup>\<infinity>)"
apply (induction i)
apply(simp)
by (simp add: sdrop_forw_rt)

lemma sntimes_stake: "i \<star> \<up>x = stake i\<cdot>((\<up>x)\<^sup>\<infinity>)"
apply(induction i)
apply simp
by (metis sinftimes_unfold sntimes.simps(2) stake_Suc)

lemma snNEqSinf [simp]: "i \<star> \<up>x \<noteq> ((\<up>x)\<^sup>\<infinity>)"
by (metis lshd_sinf sdropostake sdrops_sinf sntimes_stake stream.sel_rews(3) up_defined)

lemma sdrop_sinf[simp]: assumes "Fin y = #x"
  shows "sdrop (i * y)\<cdot>(sinftimes x) = sinftimes x"
apply(induction i)
apply(simp)
by (metis assms mult_Suc sdrop_plus sdropl6 sinftimes_unfold)

lemma sinf_notEps[simp]: assumes "xs \<noteq> \<epsilon>" shows "(sinftimes xs) \<noteq> \<epsilon>"
using assms slen_sinftimes by fastforce

lemma sinf_inf: assumes "#s = \<infinity>"
  shows "s\<^sup>\<infinity> = s"
by (metis assms sconc_fst_inf sinftimes_unfold)

lemma sinf_dupE [simp]: "(sinftimes s)\<^sup>\<infinity> = (s\<^sup>\<infinity>)"
using sinf_inf slen_sinftimes by force

lemma sntimes_Suc2: "(Suc i) \<star> s = (i\<star>s) \<Zcat> s"
apply (induction i)
apply (simp; fail)
by (metis assoc_sconc sntimes.simps(2))

lemma sinf2sntimes: assumes "Fin y = #x"
  shows "stake (i*y)\<cdot>(x\<^sup>\<infinity>) = i\<star>x"
apply(induction i)
apply (simp; fail)
by (metis assms mult_Suc sdrop_plus sdrop_sinf sntimes.simps(2) stake_add stake_y)

lemma snT_le_sinfT [simp]: "i\<star>s \<sqsubseteq> (s\<^sup>\<infinity>)"
by (metis minimal monofun_cfun_arg ninf2Fin sconc_fst_inf sconc_snd_empty sinf2sntimes sinf_inf sntimes.simps(2) sntimes_Suc2 ub_stake)

lemma sntimes_leq: "i\<star>s \<sqsubseteq> (Suc i)\<star>s"
by (metis minimal monofun_cfun_arg sconc_snd_empty sntimes_Suc2)

lemma sntimes_chain: "chain (\<lambda>i. i\<star>s)"
by (meson po_class.chainI sntimes_leq)

lemma sdrop_sinf2: assumes "xs = x\<Zcat>xs" and "#x = Fin y"
  shows "sdrop (y*i)\<cdot>xs = xs"
apply (induction i)
apply (simp ; fail)
by (metis assms mult_Suc_right sdrop_plus sdropl6)

lemma stake_eq_sinf: assumes "xs = x\<Zcat>xs" and "#x = Fin y"
  shows "stake (i*y)\<cdot>xs = stake (i*y)\<cdot>(sinftimes x)"
proof (induction i)
  case 0 thus ?case by simp
next
  case (Suc i)
  have drop_xs:"sdrop (i*y)\<cdot>xs = xs" by (metis assms mult.commute sdrop_sinf2)

  have "stake (Suc i * y)\<cdot>xs  =  stake (i*y)\<cdot>xs \<Zcat> stake y\<cdot>(sdrop (i*y)\<cdot>xs)" by (metis add.commute mult_Suc stake_add)
  hence eq1:"stake (Suc i * y)\<cdot>xs =  stake (i*y)\<cdot>xs \<Zcat> x"  by (metis approxl1 assms drop_xs minimal monofun_cfun_arg sconc_snd_empty)

  have "stake (Suc i * y)\<cdot>(sinftimes x) = stake (i*y)\<cdot>(sinftimes x) \<Zcat> stake y\<cdot>(sdrop (i*y)\<cdot>(sinftimes x))"
    by (metis add.commute mult_Suc stake_add)
  hence eq2:"stake (Suc i * y)\<cdot>(sinftimes x) =  stake (i*y)\<cdot>(sinftimes x) \<Zcat> x" by (simp add: assms(2))

  thus ?case using Suc.IH eq1 by auto
qed

lemma stake_sntimes2sntimes: assumes "j\<le>k" and "#s = Fin y"
  shows "stake (j*y)\<cdot>(k\<star>s) = j\<star>s"
by (metis assms(1) assms(2) min_def mult_le_mono1 sinf2sntimes stakeostake)

lemma lubStake2sn: assumes "#s = Fin y"
  shows "(\<Squnion> i. stake (y*j)\<cdot>(i\<star>s)) = j\<star>s" (is "(\<Squnion>i. ?c i) = _")
proof -
  have "max_in_chain j (\<lambda>i. ?c i)" by (simp add: assms max_in_chainI mult.commute stake_sntimes2sntimes)
  thus ?thesis by (simp add: assms maxinch_is_thelub mult.commute sntimes_chain stake_sntimes2sntimes)
qed

lemma sntimesChain: assumes "#s = Fin y" and "y \<noteq> 0"
  shows "\<forall>j. stake (y*j)\<cdot>(\<Squnion> i. i\<star>s) = stake (y*j)\<cdot> (s\<^sup>\<infinity>)"
by (metis assms(1) contlub_cfun_arg lubStake2sn mult.commute sinf2sntimes sntimes_chain)

lemma sntimesLub_Fin: assumes "#s = Fin y" and "y \<noteq> 0"
  shows "(\<Squnion> i. i\<star>s) = (s\<^sup>\<infinity>)"
proof -
  have  "\<forall>j. stake (j*y)\<cdot>(\<Squnion> i. i\<star>s) = stake (j*y)\<cdot> (s\<^sup>\<infinity>)" by (metis assms(1) assms(2) mult.commute sntimesChain)
  hence "\<forall>j. stake j\<cdot>(\<Squnion> i. i\<star>s) = stake j\<cdot> (s\<^sup>\<infinity>)" using assms by (metis gstake2stake)
  thus ?thesis using stream.take_lemma by auto
qed

lemma sntimesLub[simp]:"(\<Squnion> i. i\<star>s) = (s\<^sup>\<infinity>)"
apply(cases "#s = \<infinity>")
apply (metis inf2max sconc_fst_inf sinf_inf sntimes.simps(2) sntimes_chain)
by (metis Fin_0 lncases lub_eq_bottom_iff slen_empty_eq sntimesLub_Fin sntimes_chain sntimes_eps strict_icycle)

lemma rek2sinftimes: assumes "xs = x \<Zcat> xs" and "x\<noteq>\<epsilon>"
  shows "xs = sinftimes x"
proof (cases "#x = \<infinity>")
  case True thus ?thesis by (metis assms(1) sconc_fst_inf sinftimes_unfold)
next
  case False
  obtain y where y_def: "Fin y = #x \<and> y\<noteq>0"  by (metis False Fin_02bot assms(2) infI lnzero_def slen_empty_eq)
  hence "\<forall>i. stake (i*y)\<cdot>xs = stake (i*y)\<cdot>(x\<^sup>\<infinity>)" using assms(1) stake_eq_sinf by fastforce
  hence "\<forall>i. stake i\<cdot>xs = stake i\<cdot>(x\<^sup>\<infinity>)" using gstake2stake y_def by blast
  thus ?thesis  using stream.take_lemma by auto
qed

lemma s2sinftimes: assumes "xs = \<up>x \<Zcat> xs"
  shows "xs = ((\<up>x)\<^sup>\<infinity>)"
using assms rek2sinftimes by fastforce

lemma fix2sinf[simp]: "fix\<cdot>(\<Lambda> s. x \<Zcat> s) = (x\<^sup>\<infinity>)"
  by (metis eta_cfun fix_eq fix_strict rek2sinftimes sconc_snd_empty strict_icycle)

lemma snth_bool_sinftimes: "snth (Suc n) ((\<up>bool \<Zcat> \<up>(\<not> bool))\<^sup>\<infinity>) = (\<not> snth n ((\<up>bool \<Zcat> \<up>(\<not>bool))\<^sup>\<infinity>))"
  apply (induction n)
  apply (metis assoc_sconc shd1 sinftimes_unfold snth_scons snth_shd)
  by (metis (no_types, opaque_lifting) sconc_fst_empty sconc_scons' sinftimes_unfold snth_scons sup'_def)

lemma sinftimes_srt: "srt\<cdot>((\<up>a \<Zcat> \<up>b)\<^sup>\<infinity>) = ((\<up>b \<Zcat> \<up>a)\<^sup>\<infinity>)"
  apply (subst sinftimes_unfold, simp)
  by (metis (no_types, lifting) assoc_sconc rek2sinftimes sinftimes_unfold strictI)

lemma sinftimes_snth:"(n mod 2 = 0 \<longrightarrow> snth n ((\<up>a \<Zcat> \<up>b)\<^sup>\<infinity>) = a) \<and> (n mod 2 = 1 \<longrightarrow> snth n ((\<up>a \<Zcat> \<up>b)\<^sup>\<infinity>) = b)"
proof(induction n arbitrary: a b)
  case 0
  then show ?case
    by simp
next
  case (Suc n)
  moreover obtain m where m_def:"n\<noteq>0 \<Longrightarrow> n = Suc m"
    using not0_implies_Suc by auto
  ultimately show ?case
    apply(cases "n = 0")
    apply(subst sinftimes_unfold, simp)
    apply (metis sconc_scons shd1 sinftimes_unfold snth_scons snth_shd)
    apply auto[1]
    apply(subst sinftimes_unfold, simp)
    apply (simp add: snth_rt)
    apply (metis One_nat_def even_Suc parity_cases sinftimes_srt)
    apply(subst sinftimes_unfold, simp)
    apply (simp add: snth_rt)
    by (metis One_nat_def even_Suc parity_cases sinftimes_srt)
qed

lemma inv_fin_suc: "inv Fin (1 + Fin x)\<star>\<up>a =  inv Fin x\<star>\<up>a \<Zcat> \<up>a "
  apply (simp add: one_lnat_def)
  using sntimes_Suc2 plus_1_eq_Suc by auto

lemma sinftimes_sconc: "sinftimes (\<up>a \<Zcat> \<up>a) = sinftimes (\<up>a)"
  by (metis rek2sinftimes sconc_scons sinftimes_unfold supconc_neps2)


subsection \<open>@{term smap}\<close>


lemma smap_cont[simp]: "cont (\<lambda> h s. slookahd\<cdot>s\<cdot>(\<lambda> a.
                       \<up>(f a) \<Zcat> (h\<cdot>(srt\<cdot>s))))"
  by(intro cont2cont)

lemma strict_smap[simp]: "smap f\<cdot>\<epsilon> = \<epsilon>"
by (subst smap_def [THEN fix_eq2], simp)

lemma smap_scons[simp]: "smap f\<cdot>(\<up>a \<Zcat> s) = \<up>(f a) \<Zcat> smap f\<cdot>s"
by (subst smap_def [THEN fix_eq2], simp)

lemma rek2smap: assumes "\<And>a as. f\<cdot>(\<up>a \<Zcat> as) = \<up>(g a) \<Zcat> f\<cdot>as"
  and "f\<cdot>\<bottom> = \<bottom>"
  shows "f\<cdot>s = smap g\<cdot>s"
apply(rule ind [of _s])
by(simp_all add: assms)

lemma smap_sup[simp]: "smap f\<cdot>(\<up>a) = \<up>(f a)"
by (subst smap_def [THEN fix_eq2], simp)

lemma slen_smap[simp]: "#(smap f\<cdot>x) = #x"
  apply (rule ind [of _ x], auto)
  unfolding len_stream_def
  by simp

text \<open>@{term smap} maps each element @{term x} to @{term "f(x)"}\<close>
lemma smap_snth_lemma:
  "Fin n < #s \<Longrightarrow> snth n (smap f\<cdot>s) = f (snth n s)"
apply (simp add: atomize_imp)
apply (rule_tac x="s" in spec)
apply (induct_tac n, simp+)
by (rule allI, rule_tac x="x" in scases, simp+)+

lemma smaps2smap: "smap g\<cdot>(smap h\<cdot>xs) =  smap (\<lambda> x. g (h x))\<cdot>xs"
by (simp add: smap_snth_lemma snths_eq)

text \<open>@{term sdrop} after @{term smap} is like @{term smap} after @{term sdrop}\<close>
lemma sdrop_smap[simp]: "sdrop k\<cdot>(smap f\<cdot>s) = smap f\<cdot>(sdrop k\<cdot>s)"
apply (rule_tac x="k" in spec)
apply (rule ind [of _ s], simp+)
apply (rule allI)
by (case_tac "x", simp+)

text \<open>@{term "smap f"} is a homomorphism on streams with respect to concatenation\<close>
lemma smap_split: "smap f\<cdot>(a \<Zcat> b) = (smap f\<cdot>a) \<Zcat> (smap f\<cdot>b)"
proof (rule lncases [of "#a"], simp)
  fix k assume "#a = Fin k"
  thus ?thesis by (rule finind [of "a"], simp_all)
qed

lemma smap2sinf[simp]: "smap f\<cdot>(x\<^sup>\<infinity>)= ((smap f\<cdot>x)\<^sup>\<infinity>)"
by (metis (no_types) rek2sinftimes sinftimes_unfold slen_empty_eq slen_smap smap_split strict_icycle)

lemma l5: "smap g\<cdot>((\<up>x)\<^sup>\<infinity>) = ((\<up>(g x))\<^sup>\<infinity>)"
  by simp

lemma smap_hd_rst : "s \<noteq> \<epsilon> \<Longrightarrow> smap f\<cdot>s = \<up>(f (shd s)) \<Zcat> smap f\<cdot>(srt\<cdot>s)" by (metis smap_scons surj_scons)




lemma smap_inj:"inj f \<Longrightarrow> inj (Rep_cfun (smap f))"
  apply(rule injI)
  apply(rule snths_eq,auto)
  apply (metis slen_smap)
  by (metis inj_eq slen_smap smap_snth_lemma)

lemma smapnoteq:assumes "\<And>x y. x \<noteq> y \<Longrightarrow> f x \<noteq> f y"
  shows"x \<noteq> y \<Longrightarrow> smap f\<cdot>x \<noteq> smap f\<cdot>y"
  apply(cases "#x \<noteq> #y",auto)
proof(metis slen_smap)
  assume a1:"x \<noteq> y"
  assume a2:"#x = #y"
  assume a3:" smap f\<cdot>x = smap f\<cdot>y"
  obtain n where n_def:"Fin n < #x \<and>snth n x \<noteq> snth n y"
    using a1 a2 snths_eq dual_order.strict_implies_order by blast
  then have "snth n (smap f\<cdot>x) \<noteq> snth n (smap f\<cdot>y)"
    apply(subst smap_snth_lemma,simp add: n_def)
    by (simp add: a2 assms smap_snth_lemma)
  thus "False"
    by (simp add: a3)
qed

lemma smapnotbelow:assumes "\<And>x y. x \<noteq> y \<Longrightarrow> f x \<noteq> f y"
  shows"\<not>x \<sqsubseteq> y \<Longrightarrow> \<not>smap f\<cdot>x \<sqsubseteq> smap f\<cdot>y"
  apply(cases "#x = #y",auto)
proof-
  assume a1:"\<not>x \<sqsubseteq> y"
  assume a2:"#x = #y"
  assume a3:" smap f\<cdot>x \<sqsubseteq> smap f\<cdot>y"
  obtain n where n_def:"Fin n < #x \<and>snth n x \<noteq> snth n y"
    using a1 a2 snths_eq dual_order.strict_implies_order by blast
  then have "snth n (smap f\<cdot>x) \<noteq> snth n (smap f\<cdot>y)"
    apply(subst smap_snth_lemma,simp add: n_def)
    by (simp add: a2 assms smap_snth_lemma)
  thus "False"
    by (metis a2 a3 eq_slen_eq_and_less slen_smap)
next
  assume a1:"\<not>x \<sqsubseteq> y"
  assume a2:"#x \<noteq> #y"
  assume a3:" smap f\<cdot>x \<sqsubseteq> smap f\<cdot>y"
  show False
  proof(cases "#x < #y")
    case True
    then have "(\<And> n. Fin n < #x \<Longrightarrow> snth n x = snth n y) \<Longrightarrow> False"
    proof-
      assume a4:"\<And> n. Fin n < #x \<Longrightarrow> snth n x = snth n y"
      hence "\<exists>n. Fin n = #x \<longrightarrow> x = stake n\<cdot>y"
        using Suc_n_not_le_n less2nat by fastforce
      hence a:"\<exists>n. Fin n = #x \<longrightarrow> x \<sqsubseteq> y"
        by auto
      have b:"\<exists>n. Fin n = #x"
        by (metis True inf_great ninf2Fin)
      hence "x \<sqsubseteq> y"
        by (metis (no_types, lifting) True a4 dual_order.strict_implies_order slen_stake snth_less snths_eq ub_stake)
      thus False
        using a1 by blast
    qed
    then obtain n where n_def:"Fin n < #x \<and> snth n x \<noteq> snth n y"
      by blast
    then have "snth n (smap f\<cdot>x) \<noteq> snth n (smap f\<cdot>y)"
      apply(subst smap_snth_lemma,simp add: n_def)
      by (metis True assms smap_snth_lemma trans_lnless)
    then show ?thesis
      by (metis a3 n_def slen_smap snth_less)
    next
      case False
      then show ?thesis
        by (metis False a2 a3 lnless_def mono_len2 slen_smap)
  qed
qed

lemma smapnotbelowinj[simp]:assumes "inj f"
  shows"\<not>x \<sqsubseteq> y \<Longrightarrow> \<not>smap f\<cdot>x \<sqsubseteq> smap f\<cdot>y"
  apply(rule smapnotbelow)
  apply (meson assms injD)
  by(simp)

lemma smapsmap2smap: "smap f\<cdot>(smap g\<cdot>s) = smap (f o g)\<cdot>s"
  by(induction s rule: ind,auto)

lemma smap_lambdaid[simp]:"smap (\<lambda>x. x)\<cdot>s = s"
  by(induction s rule: ind,simp_all)

lemma smap_snth_in: "Fin j < #s \<Longrightarrow> snth j s \<in> M = snth j (smap (\<lambda>m. m \<in> M)\<cdot> s)"
  apply(induct j, simp_all)
   apply (metis Stream.slen_empty_eq nless_le shd1 smap_hd_rst)
  by (simp add: smap_snth_lemma)

subsection \<open>@{term sprojfst} and @{term sprojsnd}\<close>

text \<open>basic properties of @{term sprojfst}\<close>

lemma sprojfst_cont: "cont( \<lambda> x. smap fst\<cdot>x)"
  by(intro cont2cont)

lemma sprojfst_scons[simp]: "sprojfst\<cdot>(\<up>(x, y) \<Zcat> s) = \<up>x \<Zcat> sprojfst\<cdot>s"
by (unfold sprojfst_def, simp)

lemma strict_sprojfst[simp]: "sprojfst\<cdot>\<epsilon> = \<epsilon>"
by (unfold sprojfst_def, simp)

lemma sprojfst_sup[simp]: "sprojfst\<cdot>(\<up>(a,b)) = \<up>a"
by (simp add: sprojfst_def)

text \<open>same properties for @{term sprojsnd}\<close>

lemma sprojsnd_cont:"cont( \<lambda> x. smap snd\<cdot>x)"
  by(intro cont2cont)

lemma sprojsnd_scons[simp]: "sprojsnd\<cdot>(\<up>(x,y) \<Zcat> s) = \<up>y \<Zcat> sprojsnd\<cdot>s"
by (unfold sprojsnd_def, simp)

lemma strict_sprojsnd[simp]: "sprojsnd\<cdot>\<epsilon> = \<epsilon>"
by (unfold sprojsnd_def, simp)

lemma sprojsnd_sup[simp]: "sprojsnd\<cdot>(\<up>(a,b)) = \<up>b"
  by (simp add: sprojsnd_def)

lemma sprojsnd_shd:
  assumes "s \<noteq> \<epsilon>"
  shows "shd (sprojsnd\<cdot>s) = snd (shd s)"
  by (metis assms prod.collapse shd1 sprojsnd_scons surj_scons)

lemma sconc_sprojsnd_shd:
  shows "shd (sprojsnd\<cdot>(\<up>a \<Zcat> s)) = snd a"
  by (simp add: sprojsnd_shd)

text \<open>@{term sprojfst} / @{term sprojsnd} and @{term srt} commute\<close>

lemma rt_Sproj_2_eq: "sprojsnd\<cdot>(srt\<cdot>x) = srt\<cdot>(sprojsnd\<cdot>x)"
by (rule ind [of _ x], auto)

lemma rt_Sproj_1_eq: "sprojfst\<cdot>(srt\<cdot>x) = srt\<cdot>(sprojfst\<cdot>x)"
by (rule ind [of _ x], auto)


lemma slen_sprojs_eq: "#(sprojsnd\<cdot>x) = #(sprojfst\<cdot>x)"
by (rule ind [of _ "x"], auto, simp add: len_stream_def)

lemma strict_rev_sprojfst: "sprojfst\<cdot>x = \<epsilon> \<Longrightarrow> x = \<epsilon>"
by (rule ccontr, rule_tac x=x in scases, auto)

lemma strict_rev_sprojsnd: "sprojsnd\<cdot>x = \<epsilon> \<Longrightarrow> x = \<epsilon>"
by (rule ccontr, rule_tac x=x in scases, auto)

lemma slen_sprojfst: "#(sprojfst\<cdot>x) = #x"
by (rule ind [of _ "x"], auto, simp add: len_stream_def)

lemma slen_sprojsnd: "#(sprojsnd\<cdot>x) = #x"
by (rule ind [of _ "x"], auto, simp add: len_stream_def)

lemma slen_updis_eq: "#s1 = #s2 \<Longrightarrow> #(updis x1 && s1) = #(updis x2 && s2)"
  by (simp add: lscons_conv)

lemma deconstruct_infstream_h:
  assumes "#s = \<infinity>" obtains x xs where "(updis x) && xs = s \<and> #xs = \<infinity>"
  using assms inf_scase lscons_conv by blast

lemma deconstruct_infstream:
  assumes "#s = \<infinity>" obtains x xs where "(updis x) && xs = s \<and> #xs = \<infinity> \<and> xs \<noteq> \<epsilon>"
  by (metis Inf'_neq_0 assms deconstruct_infstream_h slen_empty_eq)


lemma sprojfst_shd[simp]: assumes "s\<noteq>\<epsilon>" shows "shd (sprojfst\<cdot>s) = fst (shd s)"
  by (metis assms prod.collapse shd1 sprojfst_scons surj_scons)

lemma sprojfst_snth[simp]: assumes "Fin n < #s" shows "snth n (sprojfst\<cdot>s) = fst (snth n s)"
  using assms
proof(induction n arbitrary: s)
  case 0
  then show ?case
    apply simp
    apply(rule sprojfst_shd)
    by auto
next
  case (Suc n)
  then show ?case
    apply(simp add: snth_rt)
    by (metis not_less rt_Sproj_1_eq slen_rt_ile_eq)
qed

lemma sprojfst_shd2[simp]: "shd (sprojfst\<cdot>(\<up>a \<Zcat> s)) = fst (a)"
  by simp

lemma sprojsnd_snth:
  assumes "Fin n < #s"
  shows "snth n (sprojsnd\<cdot>s) = snd (snth n s)"
  using assms
  apply (induction n arbitrary: s)
  using sprojsnd_shd apply force
  by (metis leD leI rt_Sproj_2_eq slen_rt_ile_eq snth_rt)

lemma sprojsnd_shd2[simp]: "shd (sprojsnd\<cdot>(\<up>a \<Zcat> s)) = snd (a)"
  by (simp add: sconc_sprojsnd_shd)

lemma slen_sprojs_eq2: "#(sprojfst\<cdot>x) = #(sprojsnd\<cdot>x)"
  by (simp add: slen_sprojs_eq)

lemma sprojfst_sconc: "sprojfst\<cdot>as \<Zcat> sprojfst\<cdot>bs = sprojfst\<cdot>(as \<Zcat> bs)"
  by (simp add: smap_split sprojfst_def)

subsection \<open>@{term szip}\<close>

text \<open>Basic simplification rules of @{term szip}\<close>

lemma szip_cont[simp]: "cont(\<lambda> h s1 s2. slookahd\<cdot>s1\<cdot>(\<lambda> a. slookahd\<cdot>s2\<cdot>(\<lambda> b.
                     \<up>(a,b) \<Zcat> (h\<cdot>(srt\<cdot>s1)\<cdot>(srt\<cdot>s2)))))"
  by(intro cont2cont)

lemma strict_szip_fst[simp]: "szip\<cdot>\<epsilon>\<cdot>s = \<epsilon>"
by (subst szip_def [THEN fix_eq2],simp)

lemma strict_szip_snd[simp]: "szip\<cdot>s\<cdot>\<epsilon> = \<epsilon>"
by (subst szip_def [THEN fix_eq2], simp)

lemma szip_scons[simp]: "szip\<cdot>(\<up>a\<Zcat>s1)\<cdot>(\<up>b\<Zcat>s2) = \<up>(a,b) \<Zcat> (szip\<cdot>s1\<cdot>s2)"
by (subst szip_def [THEN fix_eq2], simp)

lemma szip_sup[simp]: "szip\<cdot>(\<up>a)\<cdot>(\<up>b \<Zcat> y) = \<up>(a,b)"
by (subst szip_def [THEN fix_eq2], simp)

lemma szip_conc_sup[simp]: "szip\<cdot>(\<up>a \<Zcat> x)\<cdot>(\<up>b) = \<up>(a,b)"
by (subst szip_def [THEN fix_eq2], simp)

lemma szip_conc_sup2[simp]: "szip\<cdot>(\<up>a)\<cdot>(\<up>b) = \<up>(a,b)"
by (subst szip_def [THEN fix_eq2], simp)

text \<open>If @{term szip} returns an empty stream, an input stream was empty\<close>
lemma strict_rev_szip: "szip\<cdot>x\<cdot>y = \<epsilon> \<Longrightarrow> x = \<epsilon> \<or> y = \<epsilon>"
apply (rule_tac x=x in scases, auto)
by (rule_tac x=y in scases, auto)

text \<open>@{term sprojfst} and @{term sprojsnd} are "inverse" functions of
  @{term szip} - if the other zipped stream is infinite\<close>
lemma sprojfst_szipl1:
  "\<forall>x. #x = \<infinity> \<longrightarrow> sprojfst\<cdot>(szip\<cdot>i\<cdot>x) = i"
apply (rule ind [of _ i], auto)
by (rule_tac x=x in scases, auto)

lemma sprojsnd_szipl1:
  "\<forall>x. #x = \<infinity> \<longrightarrow> sprojsnd\<cdot>(szip\<cdot>x\<cdot>i) = i"
apply (rule ind [of _ i], auto)
by (rule_tac x=x in scases, auto)

lemma szip2sinftimes[simp]: "szip\<cdot>((\<up>x)\<^sup>\<infinity>)\<cdot>((\<up>y)\<^sup>\<infinity>) = ((\<up>(x, y))\<^sup>\<infinity>) "
by (metis s2sinftimes sinftimes_unfold szip_scons)

lemma szip_len [simp]: "#(szip\<cdot>as\<cdot>bs) = min (#as) (#bs)"
apply(induction as arbitrary: bs)
apply(rule admI)
apply auto[1]
apply (metis inf_chainl4 inf_less_eq lub_eqI lub_finch2 min_def slen_sprojsnd sprojsnd_szipl1)
apply (simp; fail)
apply(case_tac "bs=\<epsilon>")
apply auto[1]
proof -
  fix u :: "'a discr u"
  fix as:: "'a stream"
  fix bs:: "'b stream"
  assume as1: "u \<noteq> \<bottom>" and
    as2: "(\<And>bs::'b stream. #(szip\<cdot>as\<cdot>bs) = min (#as) (#bs))" and as3: "bs \<noteq> \<epsilon>"
  obtain a where a_def: "updis a = u" by (metis (mono_tags)as1 lshd_updis stream.sel_rews(4) stream.sel_rews(5) surj_scons)
  obtain b bs2 where b_def: "bs = \<up>b \<Zcat> bs2" by (metis as3 surj_scons)
  hence "#(szip\<cdot>(\<up>a \<Zcat> as)\<cdot>(\<up>b \<Zcat> bs2)) = min (#(\<up>a \<Zcat> as)) (#(\<up>b \<Zcat> bs2))" by (simp add: as2 min_def)
  thus "#(szip\<cdot>(u && as)\<cdot>bs) = min (#(u && as)) (#bs)" by (metis a_def b_def lscons_conv)
qed

lemma szip_nth: "Fin n < #s1 \<Longrightarrow> Fin n < #s2 \<Longrightarrow> snth n (szip\<cdot>s1\<cdot>s2) = (snth n s1, snth n s2)"
  apply(induction n arbitrary: s1 s2)
  apply auto[1]
  by(rule_tac x="s1" in scases; rule_tac x="s2" in scases,simp_all)+

lemma szip_sdrop: "sdrop n\<cdot>(szip\<cdot>s\<cdot>t) = szip\<cdot>(sdrop n\<cdot>s)\<cdot>(sdrop n\<cdot>t)"
  apply(induction n arbitrary: s t)
  apply(simp; fail)
  by (metis (no_types, lifting) sdrop_forw_rt sdrop_scons stream.sel_rews(2) strict_szip_fst
            strict_szip_snd surj_scons szip_scons)

text \<open>@{term sValues} of @{term szip} is subset of the Cartesian product of the sets of values of
        the zipped streams.\<close>

text \<open>@{term sprojsnd} of @{term szip} equals the second stream if its length is less or equal
        the length of the first stream.\<close>

lemma szip_sprojsnd:
  assumes "#ys \<le> #xs"
  shows "sprojsnd\<cdot>(szip\<cdot>xs\<cdot>ys) = ys"
  using assms
  apply (induction ys arbitrary: xs rule: ind, simp_all)
  apply (rule adm_all, rule adm_imp, simp_all)
  apply (rule admI)
  apply (metis dual_order.antisym inf_chainl4 inf_ub l42)
  apply (rename_tac a as bs)
  by (rule_tac x = bs in scases, simp_all)


lemma
  sdrop_snth_split:
  assumes "n < #s"
  shows "sdrop n\<cdot>s = \<up>(snth n s) \<Zcat> (sdrop (Suc n)\<cdot>s)"
  apply(simp add: snth_def)
  by (simp add: assms convert_inductive_asm drop_not_all sdrop_back_rt surj_scons)

lemma
  split_stream_snth:
  assumes "n < #s"
  shows "s = stake n\<cdot>s \<Zcat> \<up>(snth n s) \<Zcat> (sdrop (Suc n)\<cdot>s)"
  apply(subst split_streaml1[symmetric, of s n])
  by(simp add: assms sdrop_snth_split[symmetric])



lemma adm_subsetEq [simp]: "adm (\<lambda>s. g\<cdot>s \<subseteq> h\<cdot>s)"
by (metis (full_types) SetPcpo.less_set_def adm_below cont_Rep_cfun2)

lemma adm_subsetEq_rc [simp]: "adm (\<lambda>s. g\<cdot>s \<subseteq> cs)"
by (metis (no_types, lifting) adm_def chain_monofun contlub_cfun_arg lub_below set_cpo_simps(1))

lemma adm_subsetEq_lc [simp]: "adm (\<lambda>s. cs \<subseteq> h\<cdot>s)"
by (simp)

lemma adm_subsetNEq_rc [simp]: "adm (\<lambda>s. \<not> g\<cdot>s \<subseteq> cs)"
  apply(rule admI)
  apply(rule ccontr)
  by (metis SetPcpo.less_set_def is_ub_thelub monofun_cfun_arg subset_eq)

lemma sValues_adm2[simp]: "adm (\<lambda>a. sValues\<cdot>(g\<cdot>a) \<subseteq> sValues\<cdot>a)"
  apply(rule admI)
  apply (simp add: contlub_cfun_arg subset_iff)
  by (metis (mono_tags, lifting) mem_simps(8) set_cpo_simps(2))

lemma adm_finstream [simp]: "adm (\<lambda>s::'a stream. #s<\<infinity> \<longrightarrow> P s)"
apply(rule admI)
  apply auto[1]
  using inf_chainl4 len_stream_def lub_eqI lub_finch2 by fastforce

lemma adm_fin_below: "adm (\<lambda>x::'a stream . \<not> Fin n \<sqsubseteq> # x)"
  apply(rule admI)
  apply auto[1]
  by (metis inf_chainl3 finite_chain_def maxinch_is_thelub)

lemma adm_fin_below2: "adm (\<lambda>x::'a stream . \<not> Fin n \<le> # x)"
by(simp only: lnle_def adm_fin_below)


section \<open>New @{term sfilter} lemmata and @{term sfoot}\<close>

subsection \<open>New @{term sfilter} lemmata\<close>

lemma slen_lnsuc:
  shows "#(y \<Zcat> \<up>a) = lnsuc\<cdot>(#y)"
  apply(induction y)
    apply(rule admI)
  apply (metis fold_inf inf_chainl4 l42 sconc_fst_inf)
   apply (metis sconc_fst_empty sconc_snd_empty slen_scons)
  by (metis (no_types, lifting) assoc_sconc slen_scons stream.con_rews(2) stream.sel_rews(5) surj_scons)

lemma len_one_stream: "#s = Fin 1 \<Longrightarrow> \<exists>m. s = \<up>m"
  apply(rule scases [of s]; simp)
  by (metis inject_lnsuc lnat.con_rews lnzero_def one_def one_lnat_def srt_decrements_length)

lemma below_conc: assumes "z \<sqsubseteq> (y\<Zcat>\<up>a)" and "z\<noteq>(y\<Zcat>\<up>a)"
  shows "z\<sqsubseteq>y"
proof(cases "#y = \<infinity>")
  case True thus ?thesis using assms(1) sconc_fst_inf by auto
next
  case False
  obtain n_y where "Fin n_y= #y" using False ninf2Fin by fastforce
  have "#z \<le> #(y\<Zcat>\<up>a)" using assms(1) mono_slen by blast
  have "#z \<noteq> #(y\<Zcat>\<up>a)" using assms(1) assms(2) eq_slen_eq_and_less by blast
  hence "#z < #(y\<Zcat>\<up>a)" using \<open>#z \<le> #(y \<Zcat> \<up>a)\<close> lnle_def lnless_def by blast
  obtain n_z where nz_def: "Fin n_z = #z" using approxl2 assms(1) assms(2) by blast
  have "#y < #(y \<Zcat> \<up>a)"
    by (metis \<open>Fin n_y = #y\<close> len_stream_def eq_slen_eq_and_less inject_sconc lnless_def minimal monofun_cfun_arg sconc_snd_empty stream.con_rews(2) sup'_def up_defined)
  have "#y < \<infinity>" by (simp add: False lnless_def)
  hence "Fin n_z \<le> #y" by (metis Fin_Suc \<open>#z < #(y \<Zcat> \<up>a)\<close> less2lnleD lnsuc_lnle_emb nz_def slen_lnsuc)
  have "\<And>s. stake n_y\<cdot>(y \<Zcat> s) = y" by (simp add: \<open>Fin n_y = #y\<close> approxl1)
  hence "stake n_z\<cdot>y = stake n_z\<cdot>(y\<Zcat>\<up>a)" by (metis \<open>Fin n_y = #y\<close> \<open>Fin n_z \<le> #y\<close> less2nat min_def stakeostake)
  thus ?thesis by (metis \<open>Fin n_z = #z\<close> approxl1 assms(1) stream.take_below)
qed

lemma snth2sntimes: "(\<And>i. i<n \<Longrightarrow> snth i s = False) \<Longrightarrow> Fin n < #s \<Longrightarrow> (sntimes n (\<up>False)) \<sqsubseteq> s"
proof(induction n arbitrary: s)
  case 0
  then show ?case by auto
next
  case (Suc n)
    have "shd s = False"
      using Suc.prems snth_shd by blast
     hence "s = \<up>False \<Zcat> (srt\<cdot>s)"
       using Suc.prems(2) empty_is_shortest surj_scons by force
    have "(\<And>i. i < n \<Longrightarrow> snth i (srt\<cdot>s) = False)"
      using Suc.prems snth_rt by auto
     hence "n\<star>\<up>False \<sqsubseteq> (srt\<cdot>s)"
       by (meson Suc.IH Suc.prems(2) linorder_not_le slen_rt_ile_eq)
     hence "\<up>False \<Zcat> (n\<star>\<up>False) \<sqsubseteq> \<up>False \<Zcat> (srt\<cdot>s)"
       by (simp add: monofun_cfun_arg)
     then show ?case
       using \<open>s = \<up>False \<Zcat> srt\<cdot>s\<close> by auto
qed

lemma sntimes_len [simp]: "#(n\<star>\<up>a) = Fin n"
  apply(induction n)
  by auto

lemma snth_scons2: assumes "#xs = Fin n"
  shows "snth (n+m) (xs\<Zcat>ys) = snth m ys"
  apply(simp add: snth_def)
  by (simp add: add.commute assms sdrop_plus sdropl6)

lemma sconc_slen [simp]: assumes "#s<\<infinity>" and "#xs<\<infinity>"
  shows "#(s\<Zcat>xs) < \<infinity>"
by (metis Fin_neq_inf assms(1) assms(2) infI inf_ub lnle_def lnless_def slen_sconc_all_finite)

lemma sconc_slen2: "\<And>(s1::'a stream) s2::'a stream. #(s1 \<Zcat> s2) = #s1 + #s2"
proof -
  fix s1::"'a stream"
  fix s2::"'a stream"

  have "#s1 = \<infinity> \<Longrightarrow> #(s1 \<Zcat> s2) = #s1 + #s2"
    by simp
  moreover
  have "#s2 = \<infinity> \<Longrightarrow> #(s1 \<Zcat> s2) = #s1 + #s2"
    by (simp add: slen_sconc_snd_inf)
  moreover
  have "#s1 \<noteq> \<infinity> \<Longrightarrow> #s2 \<noteq> \<infinity> \<Longrightarrow> #(s1 \<Zcat> s2) = #s1 + #s2"
  proof-
    assume "#s1 \<noteq> \<infinity>"
    then obtain l_s1 where l_s1_def: "Fin l_s1 = #s1"
      using infI by metis
    assume " #s2 \<noteq> \<infinity>"
    then obtain l_s2 where l_s2_def: "Fin l_s2 =  #s2"
      using infI by metis
    show ?thesis
      using l_s1_def l_s2_def by (metis lnat_plus_fin slen_sconc_all_finite)
  qed

  then show "#(s1 \<Zcat> s2) = #s1 + #s2"
    using calculation by linarith
qed


subsection \<open>@{term sValues}\<close>

lemma sValues_eq: "{z. \<exists>n. Fin n < #s \<and> z = snth n s} = {snth n s |n. Fin n < #s}"
by auto

lemma sValues_eq2: "{snth n s |n. Fin n < #s} = {z. \<exists>n. Fin n < #s \<and> z = snth n s}"
by auto

lemma slen_snth_prefix: "#s > Fin n \<Longrightarrow> snth n s = snth n (s \<Zcat> t)"
  by (simp add: monofun_cfun_arg snth_less)

text \<open>monotonicity of @{term sValues}\<close>
lemma sValues_mono: "monofun (\<lambda>s. {snth n s |n. Fin n < #s})"
apply (simp add: sValues_eq2)
apply (rule monofunI)
apply (rule_tac x="#x" in lncases)
apply (drule eq_less_and_fst_inf; simp)
apply (simp add: atomize_imp)
apply (rule_tac x="y" in spec)
apply (rule_tac x="x" in spec)
apply (induct_tac k, simp+)
apply (auto simp add: less_set_def)[2]
apply (drule lessD, auto)
apply (erule_tac x="q" in allE)
apply (erule_tac x="w" in allE, auto)
apply (case_tac "na", auto)
apply (rule_tac x="0" in exI, auto)
apply (frule_tac mono_len2, simp)
apply (rule_tac x="Suc nat" in exI, auto)
apply (rule_tac x="#w" in lncases, auto)
by (rule snth_less, auto)

lemma inf_chainl3rf: fixes Y::"nat \<Rightarrow> 'a stream"
  shows "\<lbrakk>chain Y; \<not>finite_chain Y\<rbrakk> \<Longrightarrow> \<exists>k. Fin n \<le> #(Y k)"
by (rule inf_chainl3 [rule_format], auto)

text \<open>@{term sValues} is a continuous function\<close>
lemma sValues_cont: "cont (\<lambda>s. {snth n s | n. Fin n < #s})"
apply (rule contI2)
apply (rule sValues_mono)
apply (simp add: sValues_eq2)
apply (simp add: less_set_def)
apply (auto simp add: lub_eq_Union) [1]
apply (frule_tac n="Suc n" in inf_chainl3rf, simp+)
apply (erule exE)
apply (rule_tac x="k" in exI)
apply (rule_tac x="n" in exI)
apply (rule conjI)
apply (rule_tac x="#(Y k)" in lncases, simp+)
apply (rule sym)
apply (rule snth_less)
apply (rule_tac x="#(Y k)" in lncases, simp+)
by (rule is_ub_thelub)

text \<open>@{term sValues} is a continuous function\<close>
lemma sValues_def2: "sValues\<cdot>s = {snth n s | n. Fin n < #s}"
apply (subst sValues_def)
apply (subst beta_cfun)
by (rule sValues_cont, simp)

lemma sValues_cont2: "\<forall>Y. chain Y \<longrightarrow> sValues\<cdot>(\<Squnion> i. Y i) = (\<Squnion> i. sValues\<cdot>(Y i))"
  by (simp add: contlub_cfun_arg)

lemma svaluesSubsetI:
  assumes "#s1 \<le> #s2"
    and "\<And>n. Fin n < #s1 \<Longrightarrow> snth n s1 = snth n s2"
  shows "sValues\<cdot>s1 \<subseteq> sValues\<cdot>s2"
  using assms
  by (auto simp add: sValues_def2)

text \<open>Basic properties of @{term sValues}\<close>

lemma svalues_eps [simp]: "sValues\<cdot>\<epsilon> = {}"
by (auto simp add: sValues_def2 lnless_def)

lemma sValues2un[simp]: "sValues\<cdot>(\<up>z \<Zcat> s) = {z} \<union> sValues\<cdot>s"
apply (auto simp add: sValues_def2)[1]
apply (case_tac "n", auto)
apply (rule_tac x="0" in exI, auto)
by (rule_tac x="Suc n" in exI, auto)

lemma strict_sValues_rev: "sValues\<cdot>s = {} \<Longrightarrow> s = \<epsilon>"
apply (auto simp add: sValues_def2)[1]
apply (rule_tac x="s" in scases, auto)
by (metis Fin_02bot gr_0 lnzero_def)

lemma sValues_notempty:"s\<noteq>\<epsilon> \<longleftrightarrow> sValues\<cdot>s\<noteq>{}"
  using strict_sValues_rev by auto

(*with new lemmata not necessary:
 apply (subst sinftimes_unfold, simp)*)
(*apply (induct_tac n, auto)
apply (subst sinftimes_unfold, simp)
apply (rule_tac x="0" in exI)
by (subst sinftimes_unfold, simp)*)
lemma svalues_inftimes[simp]: "sValues\<cdot>(sinftimes (\<up>a)) = {a}"
by (auto simp add: sValues_def2)

lemma svalues_sup[simp]: "sValues\<cdot>(\<up>z) = {z}"
by (auto simp add: sValues_def2)

lemma sValues2snth: "z \<in> sValues\<cdot>s \<Longrightarrow> \<exists>n. snth n s = z"
by (auto simp add: sValues_def2)

lemma snth2sValues: "Fin n < #s \<Longrightarrow> snth n s \<in> sValues\<cdot>s"
  by (auto simp add: sValues_def2)

lemma npsmap_well:"sValues\<cdot>x\<subseteq>range f \<Longrightarrow>  \<exists>s. smap f\<cdot>s = x"
  apply(rule_tac x = "smap (inv f)\<cdot>x" in exI)
  by (simp add: snths_eq smap_snth_lemma f_inv_into_f snth2sValues subset_eq)

lemma smap_inv_id[simp]: "sValues\<cdot>s \<subseteq> range F \<Longrightarrow> smap (F \<circ> (inv F))\<cdot>s = s"
  apply (induction s  rule: ind )
  by(simp_all add: f_inv_into_f)

lemma smap_rang2values:
  assumes "sValues\<cdot>s \<subseteq> range f"
    shows "s \<in> range (Rep_cfun (smap f))"
  using assms npsmap_well by force

lemma sValues_sconc2un:
  "#x = Fin k \<Longrightarrow> sValues\<cdot>(x \<Zcat> y) = sValues\<cdot>x \<union> sValues\<cdot>y"
apply (simp add: atomize_imp)
apply (rule_tac x="x" in spec)
apply (induct_tac k, simp+)
apply (rule allI, rule impI)
by (rule_tac x="x" in scases, simp+)

lemma sconc_sValues: "sValues\<cdot>(s1\<Zcat>s2) \<subseteq> sValues\<cdot>s1 \<union> sValues\<cdot>s2"
by (metis SetPcpo.less_set_def below_refl lncases sconc_fst_inf sValues_sconc2un sup.coboundedI1)


lemma sntimes_sValues1[simp]: "sValues\<cdot>(sntimes n s) \<subseteq> sValues\<cdot>s"
proof (induction n)
  case 0 thus ?case by simp
next
  case (Suc n) thus ?case using sconc_sValues sntimes.simps(2) sup.orderE by auto
qed

text \<open>For injective functions @{term f} with @{term "f(y) = x"}, @{term x} can only
  be contained in @{term "smap f\<cdot>s"} if the original stream contained @{term y}\<close>
lemma sValues_smapl1: "\<lbrakk>x \<in> sValues\<cdot>(smap f\<cdot>s); inj f; f y = x\<rbrakk> \<Longrightarrow> y \<in> sValues\<cdot>s"
  apply (auto simp add: sValues_def2)[1]
  apply (rule_tac x="n" in exI, simp)
  apply (simp add: smap_snth_lemma)
  by (simp add: inj_on_def)

lemma sValues_sconc[simp]: "sValues\<cdot>x \<subseteq> sValues\<cdot>(x \<Zcat> xs)"
  by (metis minimal monofun_cfun_arg sconc_snd_empty set_cpo_simps(1))

lemma sinftimes_sValues[simp]: "sValues\<cdot>(sinftimes s) \<subseteq> sValues\<cdot>s"
  apply(subst sntimesLub[symmetric])
  apply(subst contlub_cfun_arg)
  apply (simp add: sntimes_chain; fail)
  apply(subst set_cpo_simps(1)[symmetric])
  apply(rule lub_below)
  apply (simp add: sntimes_chain; fail)
  by (simp add: SetPcpo.less_set_def)


lemma szip_sValues: "sValues\<cdot>(szip\<cdot>as\<cdot>bs) \<subseteq> (sValues\<cdot>as \<times> sValues\<cdot>bs)"
  apply (induction as arbitrary: bs rule: ind, simp_all)
  apply (rule adm_all, rule admI)
    apply (simp add: contlub_cfun_arg contlub_cfun_fun lub_eq_Union; blast; fail)
  apply (rename_tac a s bs)
  by (rule_tac x = bs in scases, simp_all,  blast)

lemma sinf_sValues [simp]: "sValues\<cdot>(s\<^sup>\<infinity>) = sValues\<cdot>s"
by (metis antisym_conv sValues_sconc sinftimes_sValues sinftimes_unfold)

lemma svalues_ls2s[simp]:"sValues\<cdot>(<ls>) = set ls"
  by(induction ls;simp add: lscons_conv)

(* every element produced by (smap f) is in the image of the function f *)
lemma smap_sValues: "sValues\<cdot>(smap f\<cdot>s) =  f ` sValues\<cdot>s"
  apply(auto)[1]
  apply(simp_all add: sValues_def2)
  apply (metis (mono_tags, lifting) smap_snth_lemma image_eqI mem_Collect_eq)
  using smap_snth_lemma by metis


lemma smap_sValues_range [simp]: "sValues\<cdot>(smap f\<cdot>s) \<subseteq> range f"
  apply(simp add: smap_sValues)
  by (simp add: image_subsetI)

lemma sValues_prefix [simp]: "a \<sqsubseteq> b \<Longrightarrow> sValues\<cdot>a \<subseteq> sValues\<cdot>b"
by (metis SetPcpo.less_set_def monofun_cfun_arg)

lemma sValues_chain2lub: "chain S \<Longrightarrow> sValues\<cdot>(S i) \<subseteq> sValues\<cdot>(\<Squnion> j. S j)"
using sValues_prefix is_ub_thelub by auto

lemma lubChainpre: "chain S \<Longrightarrow> S i  \<Longrightarrow> \<forall>i. S i \<sqsubseteq> s \<Longrightarrow> (\<Squnion> j. S j) \<sqsubseteq> s"
by (simp add: lub_below)

lemma sValues_chainprefix: "chain S \<Longrightarrow> \<forall>i. S i \<sqsubseteq> s \<Longrightarrow> \<forall>i. sValues\<cdot>(S i) \<subseteq> sValues\<cdot>s"
by simp

lemma sValues_chainlub: "chain S \<Longrightarrow>  \<forall>i. S i \<sqsubseteq> s \<Longrightarrow> sValues\<cdot>(\<Squnion> j. S j) \<subseteq> sValues\<cdot>s"
using sValues_prefix lub_below by blast

lemma sValues_chain_below: "chain S \<Longrightarrow> i \<le> j \<Longrightarrow> sValues\<cdot>(S i) \<subseteq> sValues\<cdot>(S j)"
by (simp add: po_class.chain_mono)

lemma sValues_lub2union: "chain S \<Longrightarrow> finite_chain S \<Longrightarrow> sValues\<cdot>(\<Squnion> j. S j) \<subseteq> (\<Union>i. sValues\<cdot>(S i))"
using l42 by fastforce

lemma sValues_lub: "chain S \<Longrightarrow> sValues\<cdot>(\<Squnion> j. S j) = (\<Union>i. sValues\<cdot>(S i))"
apply (simp add: contlub_cfun_arg)
by (simp add: lub_eq_Union)


lemma l44: assumes "chain S" and "\<forall>i. sValues\<cdot>(S i) \<subseteq> B"
  shows "sValues\<cdot>(\<Squnion> j. S j) \<subseteq> B"
by (metis (mono_tags, lifting) UN_E assms sValues_lub subsetCE subsetI)

lemma l6: "chain S \<Longrightarrow> \<forall>i. sValues\<cdot>(S i) \<subseteq> B \<Longrightarrow> sValues\<cdot>(\<Squnion> j. S (j + (SOME k. A))) \<subseteq> B"
by (simp add: l44 lub_range_shift)

lemma sdrop_sValues[simp]: "sValues\<cdot>(sdrop n\<cdot>s)\<subseteq>sValues\<cdot>s"
by (metis Un_upper2 approxl2 sValues_prefix sValues_sconc2un sdrop_0 sdropostake split_streaml1 stream.take_below)

lemma sValues_subset: assumes "u\<noteq>\<bottom>"
shows "sValues\<cdot>s\<subseteq>sValues\<cdot>(u && s)"
by (metis Un_upper2 assms sValues2un stream.con_rews(2) stream.sel_rews(5) surj_scons)

lemma adm_nsValues [simp]:  "adm (\<lambda>x. b \<notin> sValues\<cdot>x)"
proof (rule admI)
  fix Y
  assume as1: "chain Y" and as2: "\<forall>i. b\<notin>sValues\<cdot>(Y i)"
  thus "b\<notin>sValues\<cdot>(\<Squnion>i. Y i)"
  proof (cases "finite_chain Y")
    case True thus ?thesis using as1 as2 l42 by fastforce
  next
    case False
    hence "#(\<Squnion>i. Y i) = \<infinity>" using as1 inf_chainl4 by blast
    hence "\<And>n. snth n (\<Squnion>i. Y i) \<noteq> b"
    proof -
      fix n
      obtain j where "Fin n < # (Y j)"  by (metis False inf_chainl2 as1 inf_chainl3rf less_le)
      hence "snth n (Y j) \<noteq>b" using as2 snth2sValues by blast
      thus "snth n (\<Squnion>i. Y i) \<noteq> b" using \<open>Fin n < #(Y j)\<close> as1 is_ub_thelub snth_less by blast
    qed
    thus ?thesis using sValues2snth by blast
  qed
qed

lemma sValues_scons: "a \<in> sValues\<cdot>(\<up>a \<Zcat> s)"
  by simp


subsection \<open>@{term list2s}\<close>

lemma list2s_conc[simp]: "list2s (a#as) = \<up>a \<Zcat> list2s as"
by (simp add: lscons_conv)

declare list2s_Suc [simp del]

lemma list2s_fin[simp]: "#(list2s x) \<noteq> \<infinity>"
by (induct x, simp+)

lemma s2list_ex:
  "#s = Fin k \<Longrightarrow> \<exists>l. list2s l = s"
apply (simp add: atomize_imp)
apply (rule_tac x="s" in spec)
apply (induct_tac k, simp+)
apply (rule_tac x="[]" in exI, simp+)
apply (rule allI, rule impI)
apply (rule_tac x="x" in scases, simp+)
apply (erule_tac x="s" in allE)
apply (drule mp)
apply (simp add: Fin_Suc [THEN sym] del: Fin_Suc)
apply (erule exE)
by (rule_tac x="a # l" in exI, simp)

lemma s2list_eps [simp]: "s2list \<epsilon> = []"
apply (simp add: s2list_def)
apply (rule someI2_ex)
apply (rule_tac x="[]" in exI; simp; fail)
apply (simp add: atomize_imp)
by (induct_tac x, simp+)

lemma s2list_sup [simp]: "s2list (\<up>a) = [a]"
apply (simp add: s2list_def)
apply (rule someI2_ex)
apply (rule_tac x="[a]" in exI; simp; fail)
apply (simp add: atomize_imp)
apply (induct_tac x, auto)
by (case_tac "list", simp+)

lemma emptylist_below[simp]: "[] \<sqsubseteq> l"
by (simp add: sq_le_list)

lemma list2s_emb: "\<lbrakk>#s \<noteq> \<infinity>; #s' \<noteq> \<infinity>\<rbrakk> \<Longrightarrow> (s2list s \<sqsubseteq> s2list s') = (s \<sqsubseteq> s')"
apply (simp add: s2list_def)
apply (rule someI2_ex)
apply (rule_tac x="#s'" in lncases, simp)
apply (frule s2list_ex, simp; fail)
apply (rule someI2_ex)
apply (rule_tac x="#s" in lncases, simp)
apply (frule s2list_ex, simp; fail)
apply (rule iffI)
apply (drule sym, drule sym, simp)
apply (simp add: sq_le_list; fail)
by (simp add: sq_le_list)

text \<open>@{term list2s} is monotone\<close>
lemma list2s_mono: "l \<sqsubseteq> l' \<Longrightarrow> list2s l \<sqsubseteq> list2s l'"
  by (simp add: sq_le_list)

lemma append2sconc:"<(ls1 @ ls2)> = (<ls1>) \<Zcat> (<ls2>)"
  by(induction ls1,simp_all)

lemma monofun_lcons: "monofun (\<lambda>l. a # l)"
apply (rule monofunI)
apply (simp add: atomize_imp)
apply (rule_tac x="a" in spec)
apply (induct_tac x, simp+)
apply (rule allI)
apply (simp add: sq_le_list; fail)
apply (rule allI)
apply (rule impI)
apply (simp add: sq_le_list)
by (rule monofun_cfun_arg, simp)

lemma s2list2lcons: "#s \<noteq> \<infinity> \<Longrightarrow> s2list (\<up>a \<Zcat> s) = a # (s2list s)"
apply (rule_tac x="#s" in lncases, simp+)
apply (simp add: atomize_imp)
apply (rule_tac x="s" in spec)
apply (rule_tac x="a" in spec)
apply (induct_tac k, simp+)
apply (rule allI,rule allI, rule impI)
apply (rule_tac x="xa" in scases, simp+)
apply (simp add: s2list_def)
apply (rule someI2_ex)
apply (frule s2list_ex, simp; fail)
apply (rule someI2_ex)
apply (frule s2list_ex)
apply (erule exE)
apply (rule_tac x="x#a#l" in exI, simp+)
  by (rule list2s_inj [THEN iffD1], simp)

text \<open>@{term s2list} is left-inverse to @{term list2s}\<close>
lemma list2s2list[simp]: "s2list (list2s l) = l"
apply (induct_tac l, simp+)
by (subst s2list2lcons, simp+)

text \<open>Evaluation of @{term list2s} from right to left\<close>
lemma slistl5[simp]: "list2s (l @ [m]) = list2s l \<Zcat> \<up>m"
by (induct_tac l, simp+)

lemma s2list_mapsmap:
  assumes "#s < \<infinity>"
  shows "map f (s2list s) = s2list (smap f\<cdot>s)"
proof-
  obtain n where n_def: "#s = Fin n"
    using assms lnat_well_h2 by blast
  show ?thesis
    using assms
    apply (induction s rule: finind [where n="n"])
    apply (simp add: n_def)
    apply (simp; fail)
    apply (subst s2list2lcons)
    apply (force; fail)
    apply simp
    apply (subst s2list2lcons)
    apply force
    by (metis fold_inf inf_ub order.not_eq_order_implies_strict)
qed


lemma listConcat: "<l1> \<Zcat> <l2> = <(l1 @ l2)>"
apply(induction l1)
by auto

lemma smap2map: "smap g\<cdot>(<ls>) = <(map g ls)>"
apply(induction ls)
by auto

lemma list2streamFin[simp]: "#(<ls>) = Fin (length ls)"
apply(induction ls)
  by auto

lemma l2stream_finitelen[simp]:"#(<ls>) < \<infinity>"
