  apply(rule injI)
  by(case_tac x;case_tac y;simp)

lemma lnat_min_le: "(\<And>i. min (Fin i) k \<le> z) \<Longrightarrow> k \<le> z"
  by (metis (full_types) LNat.lnat.exhaust Suc_n_not_le_n less2nat min_le_iff_disj order_refl)

declare [[coercion_enabled]] [[coercion "Fin::nat\<Rightarrow>lnat"]]


definition lAdd::"lnat \<rightarrow> lnat \<rightarrow> lnat" where
"lAdd = (\<Lambda> ln1 ln2. case ln1 of Fin n \<Rightarrow> (case ln2 of Fin m \<Rightarrow> n+m | \<infinity> \<Rightarrow> \<infinity>) | \<infinity> \<Rightarrow> \<infinity>)"

lemma ladd_def_h:
   "(case y of Fin (m::nat) \<Rightarrow> Fin (x + m) | \<infinity> \<Rightarrow> \<infinity>) = y + x"
  by(cases y,simp_all)

lemma ladd_def_h2:
  "(case ln1 of Fin n \<Rightarrow> (case ln2 of Fin m \<Rightarrow> Fin (n + m) | \<infinity> \<Rightarrow> \<infinity>) | \<infinity> \<Rightarrow> \<infinity>) = ln1 + ln2"
  by(cases ln1;cases ln2;simp)

lemma ladd_infchain:
  assumes "chain Y"
  and "\<not> finite_chain Y"
  shows "\<not> finite_chain (\<lambda>i::nat. case Y i of Fin (m::nat) \<Rightarrow> Fin (x1 + m) | \<infinity> \<Rightarrow> \<infinity>)"
  apply(simp add: finite_chain_def max_in_chain_def,auto simp add: ladd_def_h assms)
  by (meson assms(1) assms(2) finite_chainl1 lnat_plus_ineq max_in_chain_def)

lemma ladd_inf:
  assumes "chain Y"
  and "\<not> finite_chain Y"
  shows "(\<Squnion>i. (case Y i of Fin (n::nat) \<Rightarrow> (case m of Fin (m::nat) \<Rightarrow> Fin (n + m) | \<infinity> \<Rightarrow> \<infinity>) | \<infinity> \<Rightarrow> \<infinity>)) = \<infinity>"
  apply(auto simp add: ladd_def_h2 assms)[1]
  apply(cases m)
  apply(rule unique_inf_lub,rule chainI)
  apply (meson assms(1) dual_order.refl lessequal_addition lnle_conv po_class.chainE; fail)
  apply(simp add: finite_chain_def max_in_chain_def, auto)
  by (meson assms(1) assms(2) finite_chainl1 lnat_plus_ineq max_in_chain_def)
  
lemma ladd_cont1[cont2cont,simp]:"cont (\<lambda>ln2. case ln1 of Fin n \<Rightarrow> (case ln2 of Fin m \<Rightarrow> n+m | \<infinity> \<Rightarrow> \<infinity>) | \<infinity> \<Rightarrow> \<infinity>)"
  apply(cases ln1,simp_all add: case_prod_unfold)
  apply(rule Cpo.contI2)
  apply(rule monofunI,case_tac x;case_tac y;simp)
  apply(case_tac "finite_chain Y")
  apply (metis (full_types) below_lub below_refl lub_eqI lub_finch2,simp)
  by (simp add: ladd_infchain)

lemma ladd_cont[simp]:"cont (\<lambda>ln1. \<Lambda> ln2. case ln1 of Fin n \<Rightarrow> (case ln2 of Fin m \<Rightarrow> n+m | \<infinity> \<Rightarrow> \<infinity>) | \<infinity> \<Rightarrow> \<infinity>)"
  apply(rule Cpo.contI2,rule monofunI,rule cfun_belowI,simp)
  apply(case_tac x;case_tac y;case_tac xa;simp)
  apply(case_tac "finite_chain Y")
  apply(metis is_ub_thelub lub_eqI lub_finch2; fail)
  apply(rule cfun_belowI)
  apply (simp add: cont2contlubE)
  apply(subst lub_fun,simp_all add: ladd_inf)
  apply(rule chainI)
  by (metis (mono_tags, lifting) fun_belowI ladd_def_h2 
      lessequal_addition lnle_conv po_class.chainE refl_lnle)

lemma ladd_insert:"lAdd\<cdot>ln1\<cdot>ln2 = ln1 + ln2"
  by(simp add: lAdd_def,simp add: ladd_def_h2)


lemma lnat_chain_fin [simp]: "chain Y \<Longrightarrow> \<not>finite_chain Y \<Longrightarrow> Y i < \<infinity>"
  by (metis LNat.inf_chainl2 inf_ub leI lnle_conv order_antisym_conv)

lemma case_lnat_fin [simp]: assumes "x<\<infinity>" shows "(case x of Fin n \<Rightarrow> f n | \<infinity> \<Rightarrow> z) = f (inv Fin x)"
  apply(cases x; simp add: assms)
  using assms by blast



lemma lnsuc_as_1_plus_fin: "lnsuc\<cdot>x = 1 + Fin x"
  apply auto
  apply (subst Suc_eq_plus1)
  by (simp add: one_lnat_def)

lemma inv_fin_append_id[simp]: "inv Fin (Fin x) = x"
  by simp

lemma fin_fin_suc [simp]: "1 + Fin x = Fin (Suc x)"
  by (simp add: one_lnat_def)

lemma inj_Iup [simp]: "inj Iup"
  by (intro injI) simp  

lemma inv_Iup_up [simp]: "inv Iup (up\<cdot>x) = x"
  by (simp add: up_def cont_Iup inv_f_f)

