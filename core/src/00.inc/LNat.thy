lemma lnat_add_leq[simp]:"(x::lnat) \<le> y \<Longrightarrow> x \<le> z + y"
  by(cases x;cases y;cases z;simp)

lemma lnat_plus_ineq[simp]:
  assumes "ln1 \<noteq> ln2"
  shows "ln1 + Fin x \<noteq> ln2 + Fin x"
  using assms
  by(cases ln1; cases ln2;simp)

