chapter MontiBelle

session "inc" (mustWork) in "00.inc" = "HOLCF" +
  description "Bundles common functionality"
  options [browser_info, document_variants="outline=-document,-theory,-lemma,-proof,-lemmas",document_tags="lemma%lemma,lemmas%lemmas",show_question_marks = false]
  sessions
    "HOL-Eisbach"
  theories
    LNat
    LNatcodegen
    SetPcpo
    Prelude
    TSynDatatype
    EventDatatype
    TOneDatatype
    TryTac
    Codegen
    Gfp
    Causality
    Classes

session "automaton" (mustWork) in "01.automaton" = "inc" +
  description "General Automaton"
  options [browser_info, document_variants="outline=-document,-theory,-lemma,-proof,-lemmas",document_tags="lemma%lemma,lemmas%lemmas",show_question_marks = false]
  theories
    Automaton
    AutomatonCausality
    DeterministicAutomaton
    Executable
    Steps
    Nda2DaSet
    AutForRel
  theories [document=false]
    AREC
  document_files (in "../11.docinc")
    "root.tex" "literatur.bib" "MontiBelle.sty" "glossary.tex"
    "chan.PNG" "componentex.PNG"

session "automaton_testing" (mustWork) in "01.automaton/Testing/" = "automaton" +
